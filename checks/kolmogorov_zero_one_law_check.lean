-- Kolmogorov's zero-one law: for an independent sequence of random variables, every event in the tail sigma-algebra has probability 0 or 1, every quantity the tail decides is almost surely a constant, and the running average either converges with probability 0 or converges almost surely to one constant.
import Mathlib.Probability.Independence.ZeroOne
import Mathlib.Data.EReal.Basic
import Mathlib.Topology.Instances.Real.Lemmas
import Mathlib.Tactic.NormNum
import Mathlib.MeasureTheory.Constructions.Polish.StronglyMeasurable
import Mathlib.MeasureTheory.Constructions.BorelSpace.Real

open MeasureTheory ProbabilityTheory Filter Topology
open scoped ENNReal

lemma avg_tendsto_iff_tail (x : ℕ → ℝ) (k : ℕ) (L : ℝ) :
    Tendsto (fun n : ℕ => (∑ i ∈ Finset.range n, x i) / (n : ℝ)) atTop (𝓝 L) ↔
    Tendsto (fun n : ℕ => (∑ i ∈ Finset.Ico k n, x i) / (n : ℝ)) atTop (𝓝 L) := by
  have hC : Tendsto (fun n : ℕ => (∑ i ∈ Finset.range k, x i) / (n : ℝ)) atTop (𝓝 0) :=
    tendsto_const_div_atTop_nhds_zero_nat _
  have heq : ∀ᶠ n : ℕ in atTop, (∑ i ∈ Finset.range n, x i) / (n : ℝ) =
      (∑ i ∈ Finset.Ico k n, x i) / (n : ℝ) + (∑ i ∈ Finset.range k, x i) / (n : ℝ) := by
    filter_upwards [eventually_ge_atTop k] with n hn
    rw [← Finset.sum_range_add_sum_Ico _ hn]
    ring
  constructor
  · intro h
    have h' := h.sub hC
    rw [sub_zero] at h'
    refine h'.congr' ?_
    filter_upwards [heq] with n hn
    rw [hn]
    ring
  · intro h
    have h' := h.add hC
    rw [add_zero] at h'
    exact h'.congr' (heq.mono fun n hn => hn.symm)

lemma measurableSet_conv_real {Ω : Type*} {m : MeasurableSpace Ω} (f : ℕ → Ω → ℝ)
    (hf : ∀ n, Measurable[m] (f n)) :
    MeasurableSet[m] {ω | ∃ L : ℝ, Tendsto (fun n => f n ω) atTop (𝓝 L)} :=
  measurableSet_exists_tendsto hf

lemma measurableSet_conv_le_real {Ω : Type*} {m : MeasurableSpace Ω} (f : ℕ → Ω → ℝ)
    (hf : ∀ n, Measurable[m] (f n)) (t : ℝ) :
    MeasurableSet[m] {ω | (∃ L : ℝ, Tendsto (fun n => f n ω) atTop (𝓝 L)) ∧
      limUnder atTop (fun n => f n ω) ≤ t} := by
  have h2 : Measurable[m] (fun ω => limUnder atTop (fun n => f n ω)) :=
    (StronglyMeasurable.limUnder fun n => (hf n).stronglyMeasurable).measurable
  exact (measurableSet_conv_real f hf).inter (measurableSet_le h2 measurable_const)

lemma measurable_partial_avg {Ω : Type*} {m : MeasurableSpace Ω} (X : ℕ → Ω → ℝ) (k : ℕ)
    (h : ∀ j, k ≤ j → Measurable[m] (X j)) (n : ℕ) :
    Measurable[m] (fun ω => (∑ i ∈ Finset.Ico k n, X i ω) / (n : ℝ)) :=
  (Finset.measurable_fun_sum _ fun i hi => h i (Finset.mem_Ico.1 hi).1).div_const _

#print axioms avg_tendsto_iff_tail
#print axioms measurableSet_conv_real
#print axioms measurableSet_conv_le_real
#print axioms measurable_partial_avg

/-- Kolmogorov's zero-one law. Let X 0, X 1, X 2, ... be independent real random variables on a
probability space (Ω, P). The tail sigma-algebra is the overlap, over every n, of the
sigma-algebra generated by the variables from X n onward (everything the terms after the first n
decide). Every event A in the tail sigma-algebra has P(A) = 0 or P(A) = 1. The terms need not
share a law. -/
theorem kolmogorov_zero_one_law {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P]
    (X : ℕ → Ω → ℝ) (hX : ∀ n, Measurable (X n)) (hind : iIndepFun X P)
    (A : Set Ω)
    (hA : MeasurableSet[⨅ n : ℕ, ⨆ (k : ℕ) (_ : n ≤ k), MeasurableSpace.comap (X k) inferInstance] A) :
    P A = 0 ∨ P A = 1 := by
  refine measure_zero_or_one_of_measurableSet_limsup_atTop
    (s := fun k => MeasurableSpace.comap (X k) inferInstance) (fun k => (hX k).comap_le)
    hind.iIndep ?_
  rwa [limsup_eq_iInf_iSup_of_nat]

/-- The constant-limit corollary. For an independent sequence as above, let Y be a random
quantity with values in the extended reals (possibly +∞ or -∞) that the tail decides: for every
real t, the event {Y ≤ t} is a tail event. Then there is one value c, possibly infinite, with
P(Y = c) = 1. -/
theorem tail_decided_quantity_is_constant {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P]
    (X : ℕ → Ω → ℝ) (hX : ∀ n, Measurable (X n)) (hind : iIndepFun X P)
    (Y : Ω → EReal)
    (hY : ∀ t : ℝ, MeasurableSet[⨅ n : ℕ, ⨆ (k : ℕ) (_ : n ≤ k),
      MeasurableSpace.comap (X k) inferInstance] {ω | Y ω ≤ (t : EReal)}) :
    ∃ c : EReal, P {ω | Y ω = c} = 1 := by
  have hle : (⨅ n : ℕ, ⨆ (k : ℕ) (_ : n ≤ k),
      MeasurableSpace.comap (X k) (inferInstance : MeasurableSpace ℝ)) ≤ ‹MeasurableSpace Ω› :=
    iInf_le_of_le 0 (iSup₂_le fun k _ => (hX k).comap_le)
  have h01 : ∀ t : ℝ, P {ω | Y ω ≤ t} = 0 ∨ P {ω | Y ω ≤ t} = 1 :=
    fun t => kolmogorov_zero_one_law P X hX hind _ (hY t)
  have hmeas : ∀ t : ℝ, MeasurableSet {ω | Y ω ≤ t} := fun t => hle _ (hY t)
  let S : Set EReal := {x | ∃ t : ℝ, x = t ∧ P {ω | Y ω ≤ t} = 1}
  refine ⟨sInf S, ?_⟩
  have h1 : P {ω | Y ω < sInf S} = 0 := by
    have hsub : {ω | Y ω < sInf S} ⊆
        ⋃ q : ℚ, {ω | Y ω < ((q : ℝ) : EReal) ∧ ((q : ℝ) : EReal) < sInf S} := by
      intro ω hω
      obtain ⟨q, hq1, hq2⟩ := EReal.lt_iff_exists_rat_btwn.1 (show Y ω < sInf S from hω)
      exact Set.mem_iUnion.2 ⟨q, hq1, hq2⟩
    refine measure_mono_null hsub (measure_iUnion_null fun q => ?_)
    by_cases hq : ((q : ℝ) : EReal) < sInf S
    · have hq0 : P {ω | Y ω ≤ ((q : ℝ) : EReal)} = 0 := by
        rcases h01 q with h | h
        · exact h
        · exact absurd (sInf_le (show ((q : ℝ) : EReal) ∈ S from ⟨(q : ℝ), rfl, h⟩)) (not_le.2 hq)
      exact measure_mono_null (fun ω hω => le_of_lt hω.1) hq0
    · simp [hq]
  have h2 : P {ω | sInf S < Y ω} = 0 := by
    have hsub : {ω | sInf S < Y ω} ⊆
        ⋃ q : ℚ, {ω | sInf S < ((q : ℝ) : EReal) ∧ ((q : ℝ) : EReal) < Y ω} := by
      intro ω hω
      obtain ⟨q, hq1, hq2⟩ := EReal.lt_iff_exists_rat_btwn.1 (show sInf S < Y ω from hω)
      exact Set.mem_iUnion.2 ⟨q, hq1, hq2⟩
    refine measure_mono_null hsub (measure_iUnion_null fun q => ?_)
    by_cases hq : sInf S < ((q : ℝ) : EReal)
    · obtain ⟨x, ⟨t, rfl, ht⟩, hxq⟩ := sInf_lt_iff.1 hq
      have hq1 : P {ω | Y ω ≤ ((q : ℝ) : EReal)} = 1 :=
        le_antisymm prob_le_one
          (ht ▸ measure_mono (fun ω (hω : Y ω ≤ t) => hω.trans (le_of_lt hxq)))
      have hc : P {ω | Y ω ≤ ((q : ℝ) : EReal)}ᶜ = 0 :=
        (prob_compl_eq_zero_iff (hmeas q)).2 hq1
      exact measure_mono_null (fun ω hω => not_le.2 hω.2) hc
    · simp [hq]
  have hne : P {ω | Y ω = sInf S}ᶜ = 0 := by
    refine measure_mono_null (fun ω hω => ?_) (measure_union_null h1 h2)
    rcases lt_or_gt_of_ne (show Y ω ≠ sInf S from hω) with h | h
    · exact Or.inl h
    · exact Or.inr h
  rw [measure_congr (ae_eq_univ.2 hne), measure_univ]

/-- The running average. For independent real random variables X 0, X 1, ..., the running
average S n / n, with S n = X 0 + ... + X (n - 1), either converges (to a finite limit) with
probability 0, or converges almost surely, and then to one constant c, the same for almost
every outcome. -/
theorem running_average_limit_is_constant {Ω : Type*} [MeasurableSpace Ω]
    (P : Measure Ω) [IsProbabilityMeasure P]
    (X : ℕ → Ω → ℝ) (hX : ∀ n, Measurable (X n)) (hind : iIndepFun X P) :
    P {ω | ∃ L : ℝ,
        Tendsto (fun n : ℕ => (∑ i ∈ Finset.range n, X i ω) / n) atTop (𝓝 L)} = 0 ∨
    ∃ c : ℝ, ∀ᵐ ω ∂P,
        Tendsto (fun n : ℕ => (∑ i ∈ Finset.range n, X i ω) / n) atTop (𝓝 c) := by
  classical
  let E : Set Ω := {ω | ∃ L : ℝ,
    Tendsto (fun n : ℕ => (∑ i ∈ Finset.range n, X i ω) / (n : ℝ)) atTop (𝓝 L)}
  have hAm : ∀ n : ℕ, Measurable (fun ω => (∑ i ∈ Finset.range n, X i ω) / (n : ℝ)) :=
    fun n => (Finset.measurable_fun_sum _ fun i _ => hX i).div_const _
  have hEm : MeasurableSet E := measurableSet_conv_real _ hAm
  have hXT : ∀ k j, k ≤ j →
      Measurable[⨆ (i : ℕ) (_ : k ≤ i), MeasurableSpace.comap (X i) inferInstance] (X j) :=
    fun k j hj => measurable_iff_comap_le.2 (le_iSup₂_of_le j hj le_rfl)
  have hEtail : MeasurableSet[⨅ n : ℕ, ⨆ (k : ℕ) (_ : n ≤ k),
      MeasurableSpace.comap (X k) inferInstance] E := by
    rw [MeasurableSpace.measurableSet_iInf]
    intro k
    have hEk : E = {ω | ∃ L : ℝ,
        Tendsto (fun n : ℕ => (∑ i ∈ Finset.Ico k n, X i ω) / (n : ℝ)) atTop (𝓝 L)} := by
      ext ω
      exact exists_congr fun L => avg_tendsto_iff_tail (fun i => X i ω) k L
    rw [hEk]
    exact measurableSet_conv_real _ (measurable_partial_avg X k (hXT k))
  let Y : Ω → EReal := fun ω => if ω ∈ E then
    ((limUnder atTop (fun n : ℕ => (∑ i ∈ Finset.range n, X i ω) / (n : ℝ)) : ℝ) : EReal)
    else ⊤
  have hYtail : ∀ t : ℝ, MeasurableSet[⨅ n : ℕ, ⨆ (k : ℕ) (_ : n ≤ k),
      MeasurableSpace.comap (X k) inferInstance] {ω | Y ω ≤ (t : EReal)} := by
    intro t
    rw [MeasurableSpace.measurableSet_iInf]
    intro k
    have hYk : {ω | Y ω ≤ (t : EReal)} = {ω | (∃ L : ℝ,
        Tendsto (fun n : ℕ => (∑ i ∈ Finset.Ico k n, X i ω) / (n : ℝ)) atTop (𝓝 L)) ∧
        limUnder atTop (fun n : ℕ => (∑ i ∈ Finset.Ico k n, X i ω) / (n : ℝ)) ≤ t} := by
      ext ω
      simp only [Set.mem_ofPred_eq, Y]
      by_cases hω : ω ∈ E
      · obtain ⟨L, hL⟩ := hω
        have hL' := (avg_tendsto_iff_tail (fun i => X i ω) k L).1 hL
        simp only [show ω ∈ E from ⟨L, hL⟩, ↓reduceIte]
        rw [hL.limUnder_eq, hL'.limUnder_eq, EReal.coe_le_coe_iff]
        exact ⟨fun h => ⟨⟨L, hL'⟩, h⟩, fun h => h.2⟩
      · simp only [hω, ↓reduceIte]
        constructor
        · intro h
          exact absurd (top_le_iff.1 h) (EReal.coe_ne_top t)
        · rintro ⟨⟨L, hL⟩, _⟩
          exact absurd ⟨L, (avg_tendsto_iff_tail (fun i => X i ω) k L).2 hL⟩ hω
    rw [hYk]
    exact measurableSet_conv_le_real _ (measurable_partial_avg X k (hXT k)) t
  rcases kolmogorov_zero_one_law P X hX hind E hEtail with h0 | h1
  · left
    exact h0
  · right
    obtain ⟨c, hc⟩ := tail_decided_quantity_is_constant P X hX hind Y hYtail
    have hEc : P Eᶜ = 0 := (prob_compl_eq_zero_iff hEm).2 h1
    have hlimm : Measurable (fun ω =>
        limUnder atTop (fun n : ℕ => (∑ i ∈ Finset.range n, X i ω) / (n : ℝ))) :=
      (StronglyMeasurable.limUnder fun n => (hAm n).stronglyMeasurable).measurable
    have hYm : Measurable Y :=
      Measurable.ite hEm (measurable_coe_real_ereal.comp hlimm) measurable_const
    have hcm : MeasurableSet {ω | Y ω = c} := hYm (measurableSet_singleton c)
    have hYc : ∀ᵐ ω ∂P, Y ω = c := by
      rw [ae_iff]
      exact (prob_compl_eq_zero_iff hcm).2 hc
    have hE : ∀ᵐ ω ∂P, ω ∈ E := by
      rw [ae_iff]
      exact hEc
    induction c using EReal.rec with
    | bot =>
      exfalso
      have hempty : {ω | Y ω = ⊥} = ∅ := by
        ext ω
        simp only [Y, Set.mem_ofPred_eq, Set.mem_empty_iff_false, iff_false]
        split_ifs <;> simp
      rw [hempty, measure_empty] at hc
      exact zero_ne_one hc
    | top =>
      exfalso
      have hsub : {ω | Y ω = ⊤} ⊆ Eᶜ := by
        intro ω hω hωE
        simp only [Y, Set.mem_ofPred_eq, hωE, ↓reduceIte] at hω
        exact EReal.coe_ne_top _ hω
      have h0 := measure_mono_null hsub hEc
      rw [hc] at h0
      exact one_ne_zero h0
    | coe r =>
      refine ⟨r, ?_⟩
      filter_upwards [hYc, hE] with ω hω hωE
      simp only [Y, hωE, ↓reduceIte, EReal.coe_eq_coe_iff] at hω
      rw [← hω]
      exact tendsto_nhds_limUnder hωE

/-! ### The card's worked numbers -/

-- Mean of one fair roll: (1 + ... + 6)/6 = 7/2.
example : (∑ f ∈ Finset.range 6, ((f : ℚ) + 1)) / 6 = 7/2 := by
  norm_num [Finset.sum_range_succ]
-- Variance of one fair roll: (1 + 4 + ... + 36)/6 - (7/2)^2 = 35/12.
example : (∑ f ∈ Finset.range 6, ((f : ℚ) + 1) ^ 2) / 6 - (7/2) ^ 2 = 35/12 := by
  norm_num [Finset.sum_range_succ]
-- No six in 10 given rolls: (5/6)^10 = 9765625/60466176.
example : (5/6 : ℚ) ^ 10 = 9765625 / 60466176 := by norm_num
-- "The first roll is a six" has chance 1/6, neither 0 nor 1.
example : (1/6 : ℚ) ≠ 0 ∧ (1/6 : ℚ) ≠ 1 := by norm_num
-- The loaded die: mean 0.1 x (1 + 2 + 3 + 4 + 5) + 0.5 x 6 = 9/2.
example : (1/10 : ℚ) * (1 + 2 + 3 + 4 + 5) + 1/2 * 6 = 9/2 := by norm_num
-- The run 6, then (4, 3, 4, 3, 3) repeated 20 times: over all 101 rolls, 10 x (total - 3.4 n)
-- runs from 26 to 34, so the total stays 2.6 to 3.4 above 3.4 n.
example :
    let path : List ℤ := 6 :: (List.replicate 20 [4, 3, 4, 3, 3]).flatten
    let d := ((path.scanl (· + ·) 0).tail.zipIdx).map (fun p => 10 * p.1 - 34 * ((p.2 : ℤ) + 1))
    d.length = 101 ∧ d.all (fun v => decide (26 ≤ v ∧ v ≤ 34)) = true := by
  decide
-- The same run with the first roll changed to 1: 10 x (total - 3.4 n) runs from -24 to -16,
-- so the total stays 1.6 to 2.4 below 3.4 n.
example :
    let path : List ℤ := 1 :: (List.replicate 20 [4, 3, 4, 3, 3]).flatten
    let d := ((path.scanl (· + ·) 0).tail.zipIdx).map (fun p => 10 * p.1 - 34 * ((p.2 : ℤ) + 1))
    d.length = 101 ∧ d.all (fun v => decide (-24 ≤ v ∧ v ≤ -16)) = true := by
  decide
-- One period (4, 3, 4, 3, 3) adds 17 = 3.4 x 5 to the total, so the pattern repeats for ever.
example : (4 + 3 + 4 + 3 + 3 : ℤ) * 10 = 34 * 5 := by norm_num

#print axioms kolmogorov_zero_one_law
#print axioms tail_decided_quantity_is_constant
#print axioms running_average_limit_is_constant
