-- Filtrations: on a coin-toss tree a quantity is known by round n exactly when it is constant on every cell of the first n results, and on fair rounds every predictable stake with finitely many values keeps the average pile at its starting value.
import Mathlib.Probability.Process.Filtration
import Mathlib.MeasureTheory.Function.ConditionalExpectation.PullOut
import Mathlib.MeasureTheory.Function.ConditionalExpectation.Real

open MeasureTheory

/-- The information of the first `n` rounds of an `N`-round coin game: the sigma-algebra
`σ(ξ_1, …, ξ_n)` generated by the results `ξ_i = ±1` (win `true` is `+1`, loss `false` is `-1`)
of the rounds numbered below `n`, on the set of win-loss histories `Fin N → Bool`. -/
@[instance_reducible]
def coinInfo (N n : ℕ) : MeasurableSpace (Fin N → Bool) :=
  ⨆ i : Fin N, ⨆ (_ : (i : ℕ) < n),
    MeasurableSpace.comap (fun ω : Fin N → Bool => if ω i then (1 : ℝ) else -1) inferInstance

/-- Each round result below `n` is known by round `n`. -/
lemma coinInfo_measurable_coord (N n : ℕ) (i : Fin N) (hi : (i : ℕ) < n) :
    Measurable[coinInfo N n] (fun ω : Fin N → Bool => ω i) := by
  have hg : Measurable[coinInfo N n] (fun ω : Fin N → Bool => if ω i then (1 : ℝ) else -1) :=
    (comap_measurable _).mono
      (le_iSup₂ (f := fun (j : Fin N) (_ : (j : ℕ) < n) => MeasurableSpace.comap
        (fun ω : Fin N → Bool => if ω j then (1 : ℝ) else -1) inferInstance) i hi) le_rfl
  have hh : Measurable (fun x : ℝ => decide (x = 1)) := by
    apply measurable_to_bool
    have : (fun x : ℝ => decide (x = 1)) ⁻¹' {true} = {1} := by ext x; simp
    rw [this]; exact measurableSet_singleton 1
  have := hh.comp hg
  convert this using 1
  funext ω
  cases h : ω i <;> norm_num [h]

/-- Forgetting the rounds from `n` on is known by round `n`. -/
lemma coinInfo_measurable_proj (N n : ℕ) :
    Measurable[coinInfo N n]
      (fun ω : Fin N → Bool => fun i : Fin N => if (i : ℕ) < n then ω i else false) := by
  refine (@measurable_pi_iff (Fin N → Bool) (Fin N) (fun _ => Bool) (coinInfo N n) _ _).mpr fun i => ?_
  by_cases hi : (i : ℕ) < n
  · simp only [hi, ite_true]; exact coinInfo_measurable_coord N n i hi
  · simp only [hi, ite_false]; exact measurable_const

/-- The events known by round `n` are exactly the unions of cells. -/
lemma coinInfo_measurableSet_iff (N n : ℕ) (s : Set (Fin N → Bool)) :
    MeasurableSet[coinInfo N n] s ↔
      ∀ ω ω' : Fin N → Bool, (∀ i : Fin N, (i : ℕ) < n → ω i = ω' i) → (ω ∈ s ↔ ω' ∈ s) := by
  constructor
  · intro hs
    let M : MeasurableSpace (Fin N → Bool) :=
      { MeasurableSet' := fun s => ∀ ω ω' : Fin N → Bool,
          (∀ i : Fin N, (i : ℕ) < n → ω i = ω' i) → (ω ∈ s ↔ ω' ∈ s)
        measurableSet_empty := by intro ω ω' _; simp
        measurableSet_compl := by
          intro s hs ω ω' h
          simp only [Set.mem_compl_iff, hs ω ω' h]
        measurableSet_iUnion := by
          intro f hf ω ω' h
          simp only [Set.mem_iUnion]
          exact exists_congr fun k => hf k ω ω' h }
    have hle : coinInfo N n ≤ M := by
      refine iSup_le fun i => iSup_le fun hi => ?_
      rintro t ⟨u, -, rfl⟩ ω ω' h
      simp only [Set.mem_preimage, h i hi]
    exact hle s hs
  · intro hs
    have hp := coinInfo_measurable_proj N n
    have hm : MeasurableSet[coinInfo N n]
        ((fun ω : Fin N → Bool => fun i : Fin N => if (i : ℕ) < n then ω i else false) ⁻¹' s) :=
      hp (Set.toFinite s).measurableSet
    convert hm using 1
    ext ω
    simp only [Set.mem_preimage]
    exact hs ω _ (fun i hi => by simp [hi])

#print axioms coinInfo_measurable_coord
#print axioms coinInfo_measurable_proj
#print axioms coinInfo_measurableSet_iff

/-- A predictable stake on fair rounds adds nothing to the average. Take any probability space
with nested information `ℱ` (a filtration), round results `ξ k` that are fair (integrable, and
averaging 0 given what is known before the round, `E[ξ (n+1) | ℱ n] = 0`), and stakes `H k` that are
predictable (`H (n+1)` is settled by `ℱ n`) with a finite range. Then each round's gain averages 0
given the round before, `E[H (n+1) ξ (n+1) | ℱ n] = 0`, and the pile `X n = x₀ + ∑_{k=1}^n H k ξ k`
averages its starting value `x₀` after every round `n`. -/
theorem predictable_stake_keeps_mean {Ω : Type*} {m0 : MeasurableSpace Ω}
    (P : Measure Ω) [IsProbabilityMeasure P] (ℱ : Filtration ℕ m0)
    (ξ H : ℕ → Ω → ℝ) (x₀ : ℝ)
    (hfair_int : ∀ n, Integrable (ξ (n + 1)) P)
    (hfair : ∀ n, P[ξ (n + 1) | ℱ n] =ᵐ[P] 0)
    (hpred : ∀ n, Measurable[ℱ n] (H (n + 1)))
    (hfin : ∀ n, (Set.range (H (n + 1))).Finite) :
    (∀ n, P[fun ω => H (n + 1) ω * ξ (n + 1) ω | ℱ n] =ᵐ[P] 0) ∧
      ∀ n, ∫ ω, (x₀ + ∑ k ∈ Finset.Icc 1 n, H k ω * ξ k ω) ∂P = x₀ := by
  have hHsm : ∀ n, StronglyMeasurable[ℱ n] (H (n + 1)) := fun n => (hpred n).stronglyMeasurable
  have hint : ∀ n, Integrable (fun ω => H (n + 1) ω * ξ (n + 1) ω) P := by
    intro n
    obtain ⟨C, hC⟩ := ((hfin n).image (fun x : ℝ => ‖x‖)).bddAbove
    refine (hfair_int n).bdd_mul (c := C)
      (((hpred n).mono (ℱ.le n) le_rfl).aestronglyMeasurable) (Filter.Eventually.of_forall ?_)
    intro ω
    exact hC ⟨H (n + 1) ω, ⟨ω, rfl⟩, rfl⟩
  have hce : ∀ n, P[fun ω => H (n + 1) ω * ξ (n + 1) ω | ℱ n] =ᵐ[P] 0 := by
    intro n
    have h1 := condExp_mul_of_stronglyMeasurable_left (μ := P) (m := ℱ n) (hHsm n)
      (hint n) (hfair_int n)
    have h2 : (fun ω => H (n + 1) ω * ξ (n + 1) ω) = H (n + 1) * ξ (n + 1) := rfl
    rw [h2]
    filter_upwards [h1, hfair n] with ω hω h0
    rw [hω, Pi.mul_apply, h0]
    simp
  refine ⟨hce, fun n => ?_⟩
  have hzero : ∀ k ∈ Finset.Icc 1 n, ∫ ω, H k ω * ξ k ω ∂P = 0 := by
    intro k hk
    obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by simp at hk; omega⟩
    rw [← integral_condExp (ℱ.le j), integral_congr_ae (hce j)]
    simp
  have hintk : ∀ k ∈ Finset.Icc 1 n, Integrable (fun ω => H k ω * ξ k ω) P := by
    intro k hk
    obtain ⟨j, rfl⟩ : ∃ j, k = j + 1 := ⟨k - 1, by simp at hk; omega⟩
    exact hint j
  rw [integral_add (integrable_const x₀) (integrable_finsetSum _ hintk),
    integral_finsetSum _ hintk, Finset.sum_eq_zero hzero]
  simp

/-- A quantity is known exactly when it is constant on every cell: on the `N`-round coin tree, a
real number `Y` read off the history is measurable for the information of the first `n` rounds
if and only if it takes one value on each cell, that is, any two histories that agree on the
rounds numbered below `n` give the same value of `Y`. -/
theorem known_iff_constant_on_cells (N n : ℕ) (Y : (Fin N → Bool) → ℝ) :
    Measurable[coinInfo N n] Y ↔
      ∀ ω ω' : Fin N → Bool, (∀ i : Fin N, (i : ℕ) < n → ω i = ω' i) → Y ω = Y ω' := by
  constructor
  · intro hY ω ω' h
    have hs := (coinInfo_measurableSet_iff N n (Y ⁻¹' {Y ω})).mp
      (hY (measurableSet_singleton (Y ω))) ω ω' h
    simp only [Set.mem_preimage, Set.mem_singleton_iff, true_iff] at hs
    exact hs.symm
  · intro hY
    have hp := coinInfo_measurable_proj N n
    have hY' : Measurable Y := measurable_of_finite Y
    convert hY'.comp hp using 1
    funext ω
    exact hY ω _ (fun i hi => by simp [hi])

/-- The information only grows, and its size is fixed by the cells: for `n ≤ N` the first `n`
rounds have `2 ^ n` cells, so they decide exactly `2 ^ (2 ^ n)` events, and every event decided by
round `n` is still decided by round `n + 1`. -/
theorem coinInfo_card_and_nested (N n : ℕ) (hn : n ≤ N) :
    Nat.card {s : Set (Fin N → Bool) // MeasurableSet[coinInfo N n] s} = 2 ^ (2 ^ n) ∧
      coinInfo N n ≤ coinInfo N (n + 1) := by
  constructor
  · let r : (Fin N → Bool) → (Fin n → Bool) := fun ω j => ω (Fin.castLE hn j)
    have hagree : ∀ ω ω' : Fin N → Bool,
        (∀ i : Fin N, (i : ℕ) < n → ω i = ω' i) ↔ r ω = r ω' := by
      intro ω ω'
      constructor
      · intro h; funext j; exact h _ j.isLt
      · intro h i hi
        have := congrFun h ⟨i, hi⟩
        simpa [r, Fin.castLE] using this
    have hsurj : Function.Surjective r := by
      intro τ
      refine ⟨fun i => if h : (i : ℕ) < n then τ ⟨i, h⟩ else false, ?_⟩
      funext j
      simp [r, Fin.castLE, j.isLt]
    let e : {s : Set (Fin N → Bool) // MeasurableSet[coinInfo N n] s} ≃ Set (Fin n → Bool) :=
      { toFun := fun s => r '' s.1
        invFun := fun t => ⟨r ⁻¹' t, (coinInfo_measurableSet_iff N n _).mpr fun ω ω' h => by
          simp only [Set.mem_preimage, (hagree ω ω').mp h]⟩
        left_inv := by
          rintro ⟨s, hs⟩
          have hs' := (coinInfo_measurableSet_iff N n s).mp hs
          apply Subtype.ext
          ext ω
          simp only [Set.mem_preimage, Set.mem_image]
          constructor
          · rintro ⟨ω', h', he⟩
            exact (hs' ω' ω ((hagree ω' ω).mpr he)).mp h'
          · intro h; exact ⟨ω, h, rfl⟩
        right_inv := fun t => Set.image_preimage_eq t hsurj }
    rw [Nat.card_congr e, Nat.card_eq_fintype_card, Fintype.card_set]
    simp
  · refine iSup_le fun i => iSup_le fun hi => ?_
    exact le_iSup₂ (f := fun (j : Fin N) (_ : (j : ℕ) < n + 1) => MeasurableSpace.comap
        (fun ω : Fin N → Bool => if ω j then (1 : ℝ) else -1) inferInstance) i (by omega)

/-- The chase rule's pile after the given results, starting from 10 chips: stake 2 when the pile is
below 10, else 1; a win (`true`) pays the stake, a loss takes it. -/
def chasePile (h : List Bool) : ℤ :=
  h.foldl (fun c w => let s := if c < 10 then 2 else 1; if w then c + s else c - s) 10

/-- The peek rule's pile: stake 1 on every round it will win, 0 on every round it will lose. -/
def peekPile (h : List Bool) : ℤ :=
  h.foldl (fun c w => if w then c + 1 else c) 10

-- The history LLW under chase: chips 10, 9, 7, 9.
example : [chasePile [], chasePile [false], chasePile [false, false],
    chasePile [false, false, true]] = [10, 9, 7, 9] := by decide
-- Chase's 8 endings, WWW to LLL, are 13, 11, 11, 9, 12, 10, 9, 5, summing to 80 (mean 10).
example : (List.ofFn fun w : Fin 8 => chasePile (List.ofFn fun k : Fin 3 =>
    !(w : ℕ).testBit (2 - k))) = [13, 11, 11, 9, 12, 10, 9, 5] := by decide
example : ∑ w : Fin 3 → Bool, chasePile (List.ofFn w) = 80 := by decide
-- Chase ends below 10 on 3 of the 8 histories.
example : (Finset.univ.filter fun w : Fin 3 → Bool => chasePile (List.ofFn w) < 10).card = 3 := by
  decide
-- Peek's 8 endings sum to 92: mean 92 / 8 = 11.5, never below 10.
example : ∑ w : Fin 3 → Bool, peekPile (List.ofFn w) = 92 := by decide
example : ∀ w : Fin 3 → Bool, 10 ≤ peekPile (List.ofFn w) := by decide
-- Chase's round-3 stake is 1 after WL and 2 after LL (piles 10 and 7), so the last result alone
-- cannot set it.
example : chasePile [true, false] = 10 ∧ chasePile [false, false] = 7 := by decide
-- Events known after rounds 0 to 3: 2, 4, 16, 256.
example : [2 ^ (2 ^ 0), 2 ^ (2 ^ 1), 2 ^ (2 ^ 2), 2 ^ (2 ^ 3)] = [2, 4, 16, 256] := by norm_num
-- All 128 predictable rules with stakes 0 or 1 (round 1 fixed, round 2 from round 1, round 3 from
-- rounds 1 and 2) give endings that sum to 80, a mean of exactly 10.
example : ∀ g1 : Bool, ∀ g2 : Bool → Bool, ∀ g3 : Bool → Bool → Bool,
    ∑ w : Fin 3 → Bool, ((10 : ℤ) + (if g1 then 1 else 0) * (if w 0 then 1 else -1)
      + (if g2 (w 0) then 1 else 0) * (if w 1 then 1 else -1)
      + (if g3 (w 0) (w 1) then 1 else 0) * (if w 2 then 1 else -1)) = 80 := by
  decide

#print axioms predictable_stake_keeps_mean
#print axioms known_iff_constant_on_cells
#print axioms coinInfo_card_and_nested
