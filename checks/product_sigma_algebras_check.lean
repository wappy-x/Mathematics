-- Product sigma-algebras: the sigma-algebra generated by measurable rectangles equals the one generated by coordinate strips and is the smallest making both coordinate maps measurable, every slice of a product-measurable set or function is measurable, and the Borel sets of the plane are the product of the Borel sets of the line.
import Mathlib.MeasureTheory.MeasurableSpace.Constructions
import Mathlib.MeasureTheory.Constructions.BorelSpace.Basic
import Mathlib.MeasureTheory.MeasurableSpace.Prod

open MeasurableSpace MeasureTheory

/-- Every slice of a product-measurable set is measurable: if `E` is in the product
sigma-algebra on `Ω₁ × Ω₂`, then for every `x` the slice `E_x = {y | (x, y) ∈ E}` is
measurable in `Ω₂`, and for every `y` the slice `E^y = {x | (x, y) ∈ E}` is measurable in
`Ω₁`. Also, if `f : Ω₁ × Ω₂ → ℝ` is measurable for the product, every slice
`f_x = fun y => f (x, y)` is measurable. No measure is needed: any two measurable spaces. -/
theorem slices_of_product_measurable_sets_and_functions_are_measurable
    {Ω₁ Ω₂ : Type*} [MeasurableSpace Ω₁] [MeasurableSpace Ω₂] :
    (∀ E : Set (Ω₁ × Ω₂), MeasurableSet E →
      (∀ x : Ω₁, MeasurableSet {y : Ω₂ | (x, y) ∈ E}) ∧
      (∀ y : Ω₂, MeasurableSet {x : Ω₁ | (x, y) ∈ E})) ∧
    (∀ f : Ω₁ × Ω₂ → ℝ, Measurable f → ∀ x : Ω₁, Measurable fun y : Ω₂ => f (x, y)) := by
  refine ⟨fun E hE => ⟨fun x => measurable_prodMk_left hE, fun y => measurable_prodMk_right hE⟩,
    fun f hf x => hf.comp measurable_prodMk_left⟩

/-- Three ways of building the product sigma-algebra agree: the product sigma-algebra on
`Ω₁ × Ω₂` is the sigma-algebra generated by the measurable rectangles `A × B`; it is also the
one generated by the strips `π₁⁻¹(A)` and `π₂⁻¹(B)`; and it is the smallest sigma-algebra on
pairs that makes both coordinate maps measurable. -/
theorem product_sigma_algebra_generated_by_rectangles_eq_by_strips_eq_smallest
    {Ω₁ Ω₂ : Type*} [MeasurableSpace Ω₁] [MeasurableSpace Ω₂] :
    (inferInstance : MeasurableSpace (Ω₁ × Ω₂)) =
        generateFrom {E | ∃ A B, MeasurableSet A ∧ MeasurableSet B ∧ E = A ×ˢ B} ∧
    (inferInstance : MeasurableSpace (Ω₁ × Ω₂)) =
        generateFrom ({E | ∃ A, MeasurableSet A ∧ E = Prod.fst ⁻¹' A} ∪
          {E | ∃ B, MeasurableSet B ∧ E = Prod.snd ⁻¹' B}) ∧
    (∀ m : MeasurableSpace (Ω₁ × Ω₂),
      (Measurable[m] (Prod.fst : Ω₁ × Ω₂ → Ω₁) ∧ Measurable[m] (Prod.snd : Ω₁ × Ω₂ → Ω₂)) ↔
        (Prod.instMeasurableSpace : MeasurableSpace (Ω₁ × Ω₂)) ≤ m) := by
  refine ⟨?_, ?_, ?_⟩
  · refine (generateFrom_eq_prod (C := {s : Set Ω₁ | MeasurableSet s})
      (D := {t : Set Ω₂ | MeasurableSet t}) generateFrom_measurableSet generateFrom_measurableSet
      isCountablySpanning_measurableSet isCountablySpanning_measurableSet).symm.trans
      (congrArg generateFrom (Set.ext fun E => ?_))
    constructor
    · rintro ⟨A, hA, B, hB, rfl⟩
      exact ⟨A, B, hA, hB, rfl⟩
    · rintro ⟨A, B, hA, hB, rfl⟩
      exact ⟨A, hA, B, hB, rfl⟩
  · show MeasurableSpace.prod _ _ = _
    rw [MeasurableSpace.prod, comap_eq_generateFrom, comap_eq_generateFrom,
      generateFrom_sup_generateFrom]
    congr 1
    ext E
    constructor
    · rintro (⟨A, hA, rfl⟩ | ⟨B, hB, rfl⟩)
      · exact Or.inl ⟨A, hA, rfl⟩
      · exact Or.inr ⟨B, hB, rfl⟩
    · rintro (⟨A, hA, rfl⟩ | ⟨B, hB, rfl⟩)
      · exact Or.inl ⟨A, hA, rfl⟩
      · exact Or.inr ⟨B, hB, rfl⟩
  · intro m
    rw [measurable_iff_comap_le, measurable_iff_comap_le, ← sup_le_iff]
    exact Iff.rfl

/-- On the plane, the Borel sets (generated by the open sets of `ℝ × ℝ`) are exactly the
product of the Borel sets of the line with themselves: `𝓑(ℝ²) = 𝓑(ℝ) ⊗ 𝓑(ℝ)`. -/
theorem borel_plane_eq_product_of_borel_line :
    borel (ℝ × ℝ) = @Prod.instMeasurableSpace ℝ ℝ (borel ℝ) (borel ℝ) := by
  borelize ℝ
  exact (Prod.borelSpace (α := ℝ) (β := ℝ)).measurable_eq.symm

/-! ### The card's whole-number examples

The scoring machine: a set of cells is a 6-bit mask, cell (column i, row j) is bit `2 i + j`.
`F₁ = {∅, L, M-or-R, everything}` as masks on 3 columns, `F₂` = all 4 subsets of 2 rows. -/

/-- The rectangle `A × B` of the scoring machine, as a 6-bit mask of cells. -/
def machineRect (a b : ℕ) : ℕ :=
  ∑ i ∈ Finset.range 3, ∑ j ∈ Finset.range 2,
    if a.testBit i && b.testBit j then 2 ^ (2 * i + j) else 0

/-- The 16 unions of the four atom cells L-bottom, L-top, M-or-R-bottom, M-or-R-top. -/
def machineProduct : Finset ℕ :=
  (Finset.range 16).image fun s =>
    (if s.testBit 0 then machineRect 1 1 else 0) + (if s.testBit 1 then machineRect 1 2 else 0) +
    (if s.testBit 2 then machineRect 6 1 else 0) + (if s.testBit 3 then machineRect 6 2 else 0)

-- the pairs of sides give 16 rectangles but only 10 distinct ones
example : ((({0, 1, 6, 7} : Finset ℕ) ×ˢ ({0, 1, 2, 3} : Finset ℕ)).image
    fun p => machineRect p.1 p.2).card = 10 := by decide

-- the product family has 16 sets, holds every rectangle, and is closed under
-- complement (in the 6 cells) and union
example : machineProduct.card = 16 := by decide
example : ∀ a ∈ ({0, 1, 6, 7} : Finset ℕ), ∀ b ∈ ({0, 1, 2, 3} : Finset ℕ),
    machineRect a b ∈ machineProduct := by decide
example : ∀ E ∈ machineProduct, 63 - E ∈ machineProduct := by decide
example : ∀ E ∈ machineProduct, ∀ F ∈ machineProduct, E ||| F ∈ machineProduct := by decide

-- the staircase {L-bottom, M-top, R-top} is in the product but is no rectangle
example : machineRect 1 1 + machineRect 6 2 ∈ machineProduct ∧
    machineRect 1 1 + machineRect 6 2 ∉ (({0, 1, 6, 7} : Finset ℕ) ×ˢ ({0, 1, 2, 3} : Finset ℕ)).image
      (fun p => machineRect p.1 p.2) := by decide

-- the single cell M-bottom is not in the product
example : machineRect 2 1 ∉ machineProduct := by decide

-- slice of the disc at x = 0.2: in tenths of a metre, the point (2, 1) lies on the circle
-- of radius 5 about (5, 5), since 3² + 4² = 5²; so the slice ends at y = 0.1 (and 0.9)
example : (2 - 5 : ℤ) ^ 2 + (1 - 5) ^ 2 = 5 ^ 2 ∧ (2 - 5 : ℤ) ^ 2 + (9 - 5) ^ 2 = 5 ^ 2 := by
  norm_num

-- squares of side 1/8 lying wholly inside the open disc: in units of 1/8, centre (4, 4),
-- radius 4; a square with lower-left corner (i, j) counts when all four corners are strictly
-- inside. There are 32, in columns of 4, 6, 6, 6, 6, 4 (two empty columns at the edges).
example : ((Finset.range 8 ×ˢ Finset.range 8).filter fun p : ℕ × ℕ =>
    ∀ u ∈ [p.1, p.1 + 1], ∀ v ∈ [p.2, p.2 + 1],
      ((u : ℤ) - 4) ^ 2 + ((v : ℤ) - 4) ^ 2 < 16).card = 32 := by decide
example : (List.range 8).map (fun i => ((Finset.range 8).filter fun j : ℕ =>
    ∀ u ∈ [i, i + 1], ∀ v ∈ [j, j + 1],
      ((u : ℤ) - 4) ^ 2 + ((v : ℤ) - 4) ^ 2 < 16).card) = [0, 4, 6, 6, 6, 6, 4, 0] := by decide

#print axioms slices_of_product_measurable_sets_and_functions_are_measurable
#print axioms product_sigma_algebra_generated_by_rectangles_eq_by_strips_eq_smallest
#print axioms borel_plane_eq_product_of_borel_line
