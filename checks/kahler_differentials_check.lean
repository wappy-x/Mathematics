-- Kahler differentials: for A = k[x_1, ..., x_n]/(f_1, ..., f_s) the module of differentials is generated by dx_1, ..., dx_n with relations exactly df_1, ..., df_s, its fibre at a k-point has dimension n minus the Jacobian rank there, and on the smooth cubic y^2 = x^3 - x it is free on one generator.
import Mathlib.RingTheory.Kaehler.Polynomial
import Mathlib.LinearAlgebra.Matrix.Rank
import Mathlib.LinearAlgebra.TensorProduct.Basic
import Mathlib.Tactic.LinearCombination
import Mathlib.Tactic.Module

open MvPolynomial KaehlerDifferential TensorProduct

theorem kd_D_mk {k : Type*} [Field k] {n : ℕ} (J : Ideal (MvPolynomial (Fin n) k))
    (g : MvPolynomial (Fin n) k) :
    D k (MvPolynomial (Fin n) k ⧸ J) (Ideal.Quotient.mk J g) =
      ∑ i, Ideal.Quotient.mk J (pderiv i g) •
        D k (MvPolynomial (Fin n) k ⧸ J) (Ideal.Quotient.mk J (X i)) := by
  classical
  induction g using MvPolynomial.induction_on with
  | C a =>
    rw [← MvPolynomial.algebraMap_eq, Ideal.Quotient.mk_algebraMap, Derivation.map_algebraMap]
    simp only [MvPolynomial.algebraMap_eq, pderiv_C, map_zero]
    exact (Finset.sum_eq_zero fun i _ => zero_smul (MvPolynomial (Fin n) k ⧸ J)
      (D k (MvPolynomial (Fin n) k ⧸ J) (Ideal.Quotient.mk J (X i)))).symm
  | add p r hp hr =>
    rw [map_add, map_add, hp, hr, ← Finset.sum_add_distrib]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [map_add, map_add]
    module
  | mul_X p i hp =>
    rw [map_mul, Derivation.leibniz, hp, Finset.smul_sum]
    have e : ∀ x, Ideal.Quotient.mk J (pderiv x (p * X i)) •
        D k (MvPolynomial (Fin n) k ⧸ J) (Ideal.Quotient.mk J (X x)) =
        Ideal.Quotient.mk J (X i) • Ideal.Quotient.mk J (pderiv x p) •
          D k (MvPolynomial (Fin n) k ⧸ J) (Ideal.Quotient.mk J (X x)) +
        (Ideal.Quotient.mk J p *
          Ideal.Quotient.mk J (Pi.single (M := fun _ => MvPolynomial (Fin n) k) x 1 i)) •
          D k (MvPolynomial (Fin n) k ⧸ J) (Ideal.Quotient.mk J (X x)) := by
      intro x
      rw [pderiv_mul, pderiv_X, map_add, map_mul, map_mul]
      module
    rw [Finset.sum_congr rfl fun x _ => e x, Finset.sum_add_distrib, add_comm]
    congr 1
    rw [Finset.sum_eq_single i]
    · rw [Pi.single_eq_same, map_one, mul_one]
    · intro b _ hb
      rw [Pi.single_eq_of_ne (Ne.symm hb), map_zero, mul_zero]
      exact zero_smul (MvPolynomial (Fin n) k ⧸ J)
        (D k (MvPolynomial (Fin n) k ⧸ J) (Ideal.Quotient.mk J (X b)))
    · simp

#print axioms kd_D_mk

theorem kd_sum_single {R : Type*} [CommRing R] {n : ℕ} (c : Fin n → R) :
    ∑ i, c i • (Pi.single i (1 : R) : Fin n → R) = c := by
  classical
  ext j; simp [Finset.sum_apply, Pi.single_apply]

#print axioms kd_sum_single

theorem kd_exists_lift {k : Type*} [Field k] {n : ℕ} (J : Ideal (MvPolynomial (Fin n) k))
    (S : Set (MvPolynomial (Fin n) k)) (hJ : J = Ideal.span S)
    {M : Type*} [AddCommGroup M] [Module (MvPolynomial (Fin n) k ⧸ J) M] [Module k M]
    [IsScalarTower k (MvPolynomial (Fin n) k ⧸ J) M] (m : Fin n → M)
    (hm : ∀ g ∈ S, ∑ i, Ideal.Quotient.mk J (pderiv i g) • m i = 0) :
    ∃ φ : Ω[(MvPolynomial (Fin n) k ⧸ J)⁄k] →ₗ[MvPolynomial (Fin n) k ⧸ J] M,
      ∀ i, φ (D k _ (Ideal.Quotient.mk J (X i))) = m i := by
  classical
  set q := Ideal.Quotient.mk J with hq
  have hqs : ∀ (c : k) (g : MvPolynomial (Fin n) k), q (c • g) = c • q g := by
    intro c g
    rw [hq, ← Ideal.Quotient.mkₐ_eq_mk k, map_smul]
  let Δ : MvPolynomial (Fin n) k →ₗ[k] M :=
    { toFun := fun g => ∑ i, q (pderiv i g) • m i
      map_add' := by intro a b; simp [add_smul, Finset.sum_add_distrib]
      map_smul' := by
        intro c a
        simp only [RingHom.id_apply, Finset.smul_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [Derivation.map_smul, hqs, smul_assoc] }
  have hΔ : ∀ g, Δ g = ∑ i, q (pderiv i g) • m i := fun g => rfl
  have hΔmul : ∀ g h, Δ (g * h) = q g • Δ h + q h • Δ g := by
    intro g h
    simp only [hΔ, pderiv_mul, map_add, map_mul, add_smul, mul_smul, Finset.sum_add_distrib,
      Finset.smul_sum]
    rw [add_comm]
    congr 1
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [smul_comm]
  have hΔI : ∀ g ∈ J, Δ g = 0 := by
    intro g hg
    rw [hJ] at hg
    induction hg using Submodule.span_induction with
    | mem x hx => exact hm x hx
    | zero => exact map_zero Δ
    | add x y _ _ hx hy => rw [map_add, hx, hy, add_zero]
    | smul a x hx' hx =>
      rw [smul_eq_mul, hΔmul, hx, smul_zero, zero_add]
      have : q x = 0 := by
        rw [hq, Ideal.Quotient.eq_zero_iff_mem, hJ]; exact hx'
      rw [this]
      exact zero_smul (MvPolynomial (Fin n) k ⧸ J) (Δ a)
  have hwd : ∀ g h, q g = q h → Δ g = Δ h := by
    intro g h e
    rw [hq, Ideal.Quotient.eq] at e
    have := hΔI _ e
    rwa [map_sub, sub_eq_zero] at this
  let out : (MvPolynomial (Fin n) k ⧸ J) → MvPolynomial (Fin n) k :=
    fun a => (Ideal.Quotient.mk_surjective a).choose
  have hout : ∀ a, q (out a) = a := fun a => (Ideal.Quotient.mk_surjective a).choose_spec
  let L : (MvPolynomial (Fin n) k ⧸ J) →ₗ[k] M :=
    { toFun := fun a => Δ (out a)
      map_add' := by
        intro a b
        rw [← map_add]; apply hwd; rw [map_add, hout, hout, hout]
      map_smul' := by
        intro c a
        rw [RingHom.id_apply, ← map_smul]; apply hwd; rw [hqs, hout, hout] }
  let δ : Derivation k (MvPolynomial (Fin n) k ⧸ J) M :=
    Derivation.mk' L (by
      intro a b
      show Δ (out (a * b)) = a • Δ (out b) + b • Δ (out a)
      rw [hwd (out (a * b)) (out a * out b) (by rw [map_mul, hout, hout, hout]), hΔmul,
        hout, hout])
  have hδ : ∀ g, δ (q g) = Δ g := fun g => hwd _ _ (hout _)
  refine ⟨δ.liftKaehlerDifferential, fun i => ?_⟩
  rw [Derivation.liftKaehlerDifferential_comp_D, hδ, hΔ, Finset.sum_eq_single i]
  · rw [pderiv_X, Pi.single_eq_same, map_one, one_smul]
  · intro b _ hb
    rw [pderiv_X, Pi.single_eq_of_ne (Ne.symm hb), map_zero]
    exact zero_smul (MvPolynomial (Fin n) k ⧸ J) (m b)
  · simp

#print axioms kd_exists_lift

theorem kd_span {k : Type*} [Field k] {n : ℕ} (J : Ideal (MvPolynomial (Fin n) k))
    (ω : Ω[(MvPolynomial (Fin n) k ⧸ J)⁄k]) :
    ∃ v : Fin n → MvPolynomial (Fin n) k ⧸ J,
      ω = ∑ i, v i • D k (MvPolynomial (Fin n) k ⧸ J) (Ideal.Quotient.mk J (X i)) := by
  have hle : Submodule.span (MvPolynomial (Fin n) k ⧸ J)
      (Set.range (D k (MvPolynomial (Fin n) k ⧸ J))) ≤
      Submodule.span (MvPolynomial (Fin n) k ⧸ J)
        (Set.range fun i => D k (MvPolynomial (Fin n) k ⧸ J) (Ideal.Quotient.mk J (X i))) := by
    rw [Submodule.span_le]
    rintro _ ⟨a, rfl⟩
    obtain ⟨g, rfl⟩ := Ideal.Quotient.mk_surjective a
    rw [kd_D_mk]
    exact Submodule.sum_mem _ fun i _ => Submodule.smul_mem _ _ (Submodule.subset_span ⟨i, rfl⟩)
  have hω := hle ((KaehlerDifferential.span_range_derivation k (MvPolynomial (Fin n) k ⧸ J)).symm ▸ Submodule.mem_top
    (x := ω))
  obtain ⟨v, hv⟩ := (Submodule.mem_span_range_iff_exists_fun _).mp hω
  exact ⟨v, hv.symm⟩

#print axioms kd_span

/-- The presentation of the Kahler differentials. Let k be a field and A = k[x_1, ..., x_n]/I
the coordinate ring cut out by equations f_1, ..., f_s, with I = ⟨f_1, ..., f_s⟩, and let
d : A → Ω_{A/k} be the universal derivation. Then
(1) every polynomial g has dg = (∂g/∂x_1) dx_1 + ... + (∂g/∂x_n) dx_n, with formal partials;
(2) dx_1, ..., dx_n generate Ω_{A/k} as an A-module;
(3) a combination v_1 dx_1 + ... + v_n dx_n is zero in Ω_{A/k} exactly when the coefficient
vector (v_1, ..., v_n) is an A-combination of the rows df_j = (∂f_j/∂x_1, ..., ∂f_j/∂x_n).
So Ω_{A/k} = (A dx_1 ⊕ ... ⊕ A dx_n)/⟨df_1, ..., df_s⟩. -/
theorem kaehler_differentials_presentation {k : Type*} [Field k] {n s : ℕ}
    (f : Fin s → MvPolynomial (Fin n) k) :
    let A := MvPolynomial (Fin n) k ⧸ Ideal.span (Set.range f)
    let q : MvPolynomial (Fin n) k →+* A := Ideal.Quotient.mk (Ideal.span (Set.range f))
    let dx : Fin n → Ω[A⁄k] := fun i => D k A (q (X i))
    (∀ g : MvPolynomial (Fin n) k, D k A (q g) = ∑ i, q (pderiv i g) • dx i) ∧
    (∀ ω : Ω[A⁄k], ∃ v : Fin n → A, ω = ∑ i, v i • dx i) ∧
    (∀ v : Fin n → A, ∑ i, v i • dx i = 0 ↔
        v ∈ Submodule.span A
          (Set.range fun j : Fin s => fun i : Fin n => q (pderiv i (f j)))) := by
  intro A q dx
  refine ⟨fun g => kd_D_mk _ g, fun ω => kd_span _ ω, fun v => ?_⟩
  set N := Submodule.span A (Set.range fun j : Fin s => fun i : Fin n => q (pderiv i (f j)))
    with hN
  constructor
  · intro hv
    obtain ⟨φ, hφ⟩ := kd_exists_lift (k := k) (Ideal.span (Set.range f)) (Set.range f) rfl
      (M := (Fin n → A) ⧸ N) (fun i => N.mkQ (Pi.single i 1)) (by
        rintro _ ⟨j, rfl⟩
        simp only [← map_smul, ← map_sum]
        rw [kd_sum_single, Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero]
        exact Submodule.subset_span ⟨j, rfl⟩)
    have h := congrArg φ hv
    simp only [map_sum, map_smul, map_zero, dx, q] at h
    have h' : N.mkQ v = 0 := by
      rw [← kd_sum_single v, map_sum]
      simp only [map_smul]
      refine (Finset.sum_congr rfl fun i _ => ?_).trans h
      exact congrArg (v i • ·) (hφ i).symm
    rwa [Submodule.mkQ_apply, Submodule.Quotient.mk_eq_zero] at h'
  · intro hv
    have hle : N ≤ LinearMap.ker (Fintype.linearCombination A dx) := by
      rw [Submodule.span_le]
      rintro _ ⟨j, rfl⟩
      simp only [SetLike.mem_coe, LinearMap.mem_ker, Fintype.linearCombination_apply]
      rw [← kd_D_mk]
      have : q (f j) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, rfl⟩)
      rw [this, map_zero]
    exact hle hv

/-- The fibre at a point is a small linear system. Let P be a point of V(f_1, ..., f_s) with
coordinates in k, given as a k-algebra map A → k (evaluation at P), so k(P) = k. Then the fibre
Ω_{A/k} ⊗ k(P) is a k-vector space of dimension n - rank J(P), where J(P) is the Jacobian matrix
with rows (∂f_j/∂x_1 (P), ..., ∂f_j/∂x_n (P)). -/
theorem finrank_fibre_eq_sub_jacobian_rank {k : Type*} [Field k] {n s : ℕ}
    (f : Fin s → MvPolynomial (Fin n) k)
    (P : (MvPolynomial (Fin n) k ⧸ Ideal.span (Set.range f)) →ₐ[k] k) :
    letI : Algebra (MvPolynomial (Fin n) k ⧸ Ideal.span (Set.range f)) k := P.toRingHom.toAlgebra
    Module.finrank k
        (k ⊗[MvPolynomial (Fin n) k ⧸ Ideal.span (Set.range f)]
          Ω[(MvPolynomial (Fin n) k ⧸ Ideal.span (Set.range f))⁄k]) =
      n - (Matrix.of fun (j : Fin s) (i : Fin n) =>
        P (Ideal.Quotient.mk _ (pderiv i (f j)))).rank := by
  let _ : Algebra (MvPolynomial (Fin n) k ⧸ Ideal.span (Set.range f)) k := P.toRingHom.toAlgebra
  classical
  let J := Ideal.span (Set.range f)
  let A := MvPolynomial (Fin n) k ⧸ J
  let q : MvPolynomial (Fin n) k →+* A := Ideal.Quotient.mk J
  let dx : Fin n → Ω[A⁄k] := fun i => D k A (q (X i))
  let rowP : Fin s → Fin n → k := fun j i => P (q (pderiv i (f j)))
  let W : Submodule k (Fin n → k) := Submodule.span k (Set.range rowP)
  let Ψ : (Fin n → k) →ₗ[k] k ⊗[A] Ω[A⁄k] :=
    Fintype.linearCombination k (fun i => (1 : k) ⊗ₜ[A] dx i)
  have hΨ : ∀ w, Ψ w = ∑ i, w i ⊗ₜ[A] dx i := by
    intro w
    simp only [Ψ, Fintype.linearCombination_apply]
    refine Finset.sum_congr rfl fun i _ => ?_
    rw [TensorProduct.smul_tmul', smul_eq_mul, mul_one]
  have hsm : ∀ (a : A) (t : k), a • t = P a * t := fun a t => rfl
  have hsurj : Function.Surjective Ψ := by
    intro x
    induction x using TensorProduct.inductionOn with
    | tmul t ω =>
      obtain ⟨v, rfl⟩ := kd_span J ω
      refine ⟨fun i => P (v i) * t, ?_⟩
      rw [hΨ, TensorProduct.tmul_sum]
      refine Finset.sum_congr rfl fun i _ => ?_
      exact (congrArg (· ⊗ₜ[A] dx i) (hsm (v i) t).symm).trans
        (TensorProduct.smul_tmul (v i) t (dx i))
    | add x y hx hy =>
      obtain ⟨a, rfl⟩ := hx
      obtain ⟨b, rfl⟩ := hy
      exact ⟨a + b, map_add Ψ a b⟩
  have hker : LinearMap.ker Ψ = W := by
    apply le_antisymm
    · intro w hw
      by_contra hwW
      obtain ⟨l, hlw, hlW⟩ := Submodule.exists_dual_map_eq_bot_of_notMem hwW inferInstance
      have hlrow : ∀ j, l (rowP j) = 0 := by
        intro j
        have h1 := Submodule.mem_map_of_mem (f := l) (Submodule.subset_span ⟨j, rfl⟩ : rowP j ∈ W)
        rw [hlW] at h1
        simpa using h1
      have : IsScalarTower k A k := ⟨fun c a t => by
        show P (c • a) * t = c * (P a * t)
        rw [map_smul, smul_eq_mul, mul_assoc]⟩
      obtain ⟨φ, hφ⟩ := kd_exists_lift J (Set.range f) rfl (M := k)
        (fun i => l (Pi.single i 1)) (by
          rintro _ ⟨j, rfl⟩
          rw [← hlrow j]
          conv_rhs => rw [← kd_sum_single (rowP j)]
          rw [map_sum]
          refine Finset.sum_congr rfl fun i _ => ?_
          rw [map_smul, smul_eq_mul, hsm])
      let Φ : k ⊗[A] Ω[A⁄k] →ₗ[A] k := TensorProduct.lift ((LinearMap.mul A k).compl₂ φ)
      have hΦ : Φ (Ψ w) = l w := by
        rw [hΨ, map_sum]
        conv_rhs => rw [← kd_sum_single w, map_sum]
        refine Finset.sum_congr rfl fun i _ => ?_
        rw [TensorProduct.lift.tmul, LinearMap.compl₂_apply, LinearMap.mul_apply', map_smul,
          smul_eq_mul]
        exact congrArg (w i * ·) (hφ i)
      rw [LinearMap.mem_ker] at hw
      rw [hw, map_zero] at hΦ
      exact hlw hΦ.symm
    · rw [Submodule.span_le]
      rintro _ ⟨j, rfl⟩
      simp only [SetLike.mem_coe, LinearMap.mem_ker]
      have h0 : ∑ i, q (pderiv i (f j)) • dx i = 0 := by
        rw [← kd_D_mk]
        have : q (f j) = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span ⟨j, rfl⟩)
        rw [this, map_zero]
      rw [hΨ]
      calc ∑ i, rowP j i ⊗ₜ[A] dx i = ∑ i, (1 : k) ⊗ₜ[A] (q (pderiv i (f j)) • dx i) := by
            refine Finset.sum_congr rfl fun i _ => ?_
            exact (congrArg (· ⊗ₜ[A] dx i)
              (by rw [hsm, mul_one] : rowP j i = q (pderiv i (f j)) • (1 : k))).trans
              (TensorProduct.smul_tmul (q (pderiv i (f j))) (1 : k) (dx i))
        _ = (1 : k) ⊗ₜ[A] (∑ i, q (pderiv i (f j)) • dx i) := (TensorProduct.tmul_sum _ _ _).symm
        _ = 0 := by rw [h0, TensorProduct.tmul_zero]
  have hrank : (Matrix.of fun (j : Fin s) (i : Fin n) =>
      P (Ideal.Quotient.mk _ (pderiv i (f j)))).rank = Module.finrank k W :=
    Matrix.rank_eq_finrank_span_row _
  rw [hrank, ← (Ψ.quotKerEquivOfSurjective hsurj).finrank_eq, hker]
  have := Submodule.finrank_quotient_add_finrank W
  rw [Module.finrank_fin_fun] at this
  omega

/-- On the smooth cubic y^2 = x^3 - x over ℚ the differentials form a line bundle, in fact a free
module of rank 1: with A = ℚ[x, y]/(y^2 - x^3 + x), u = (3/2)x^2 - 1 and v = -(9/4)xy, the
differential ω = u dy + v dx generates Ω_{A/ℚ}, and every differential is a ω for exactly one
function a in A. -/
theorem smooth_cubic_differentials_free_on_omega :
    let A := MvPolynomial (Fin 2) ℚ ⧸ Ideal.span {X 1 ^ 2 - X 0 ^ 3 + X 0}
    let q : MvPolynomial (Fin 2) ℚ →+* A := Ideal.Quotient.mk _
    let u : A := q (C (3 / 2) * X 0 ^ 2 - 1)
    let v : A := q (C (-9 / 4) * X 0 * X 1)
    let ω : Ω[A⁄ℚ] := u • D ℚ A (q (X 1)) + v • D ℚ A (q (X 0))
    ∀ η : Ω[A⁄ℚ], ∃! a : A, η = a • ω := by
  intro A q u v ω
  classical
  let g : MvPolynomial (Fin 2) ℚ := X 1 ^ 2 - X 0 ^ 3 + X 0
  let J : Ideal (MvPolynomial (Fin 2) ℚ) := Ideal.span {g}
  let x : A := q (X 0)
  let y : A := q (X 1)
  let t : A := algebraMap ℚ A (1 / 2)
  let dx : Ω[A⁄ℚ] := D ℚ A x
  let dy : Ω[A⁄ℚ] := D ℚ A y
  have hω : ω = u • dy + v • dx := rfl
  have hqC : ∀ c : ℚ, q (C c) = algebraMap ℚ A c := fun c => by
    rw [← MvPolynomial.algebraMap_eq]; exact Ideal.Quotient.mk_algebraMap _ _ _
  have h2 : 2 * t = 1 := by
    show 2 * algebraMap ℚ A (1 / 2) = 1
    rw [← map_ofNat (algebraMap ℚ A) 2, ← map_mul]; norm_num
  have hg0 : q g = 0 := Ideal.Quotient.eq_zero_iff_mem.mpr (Ideal.subset_span rfl)
  have hg : y ^ 2 - x ^ 3 + x = 0 := by
    have := hg0
    simp only [g, map_add, map_sub, map_pow] at this
    exact this
  have hu : u = 3 * t * x ^ 2 - 1 := by
    show q (C (3 / 2) * X 0 ^ 2 - 1) = _
    rw [map_sub, map_mul, map_pow, map_one, hqC,
      show (3 / 2 : ℚ) = 3 * (1 / 2) by norm_num, map_mul, map_ofNat]
  have hv : v = -9 * t ^ 2 * x * y := by
    show q (C (-9 / 4) * X 0 * X 1) = _
    rw [map_mul, map_mul, hqC,
      show (-9 / 4 : ℚ) = -9 * (1 / 2) ^ 2 by norm_num, map_mul, map_pow, map_neg, map_ofNat]
  have hp0 : q (pderiv 0 g) = 1 - 3 * x ^ 2 := by
    simp [g, pderiv_X, x, map_ofNat]
    ring
  have hp1 : q (pderiv 1 g) = 2 * y := by
    simp [g, pderiv_X, y, map_ofNat]
  have hRel : (1 - 3 * x ^ 2) • dx + (2 * y) • dy = 0 := by
    have h := kd_D_mk J g
    rw [Fin.sum_univ_two] at h
    have h' : D ℚ A (q g) = 0 := by rw [hg0]; exact map_zero _
    rw [← hp0, ← hp1]
    exact h.symm.trans h'
  have key : u * (3 * x ^ 2 - 1) + v * (2 * y) = 1 := by
    rw [hu, hv]
    linear_combination (-9 * t * x ^ 4 + 3 * x ^ 2 * (3 * t + 1)) * h2 - 18 * t ^ 2 * x * hg
  clear_value ω
  have hdx : dx = (2 * y) • ω := by
    rw [hω]
    calc dx = (u * (3 * x ^ 2 - 1) + v * (2 * y)) • dx := by
          rw [key]; exact (one_smul A dx).symm
      _ = (2 * y) • (u • dy + v • dx) := by
          linear_combination (norm := module) (-u) • hRel
  have hdy : dy = (3 * x ^ 2 - 1) • ω := by
    rw [hω]
    calc dy = (u * (3 * x ^ 2 - 1) + v * (2 * y)) • dy := by
          rw [key]; exact (one_smul A dy).symm
      _ = (3 * x ^ 2 - 1) • (u • dy + v • dx) := by
          linear_combination (norm := module) v • hRel
  obtain ⟨φ, hφ⟩ := kd_exists_lift J {g} rfl (M := A) ![2 * y, 3 * x ^ 2 - 1] (by
    rintro _ rfl
    rw [Fin.sum_univ_two]
    have e0 : Ideal.Quotient.mk J (pderiv 0 g) = 1 - 3 * x ^ 2 := hp0
    have e1 : Ideal.Quotient.mk J (pderiv 1 g) = 2 * y := hp1
    rw [e0, e1]
    simp only [Matrix.cons_val_zero, Matrix.cons_val_one, smul_eq_mul]
    ring)
  have hφx : φ dx = 2 * y := hφ 0
  have hφy : φ dy = 3 * x ^ 2 - 1 := hφ 1
  have hφω : φ ω = 1 := by
    rw [hω, map_add, map_smul, map_smul, hφx, hφy, smul_eq_mul, smul_eq_mul]
    linear_combination key
  intro η
  obtain ⟨w, hw⟩ := kd_span J η
  rw [Fin.sum_univ_two] at hw
  have hw' : η = w 0 • dx + w 1 • dy := hw
  have hc : η = (w 0 * (2 * y) + w 1 * (3 * x ^ 2 - 1)) • ω := by
    rw [hw', hdx, hdy]
    module
  refine ⟨w 0 * (2 * y) + w 1 * (3 * x ^ 2 - 1), hc, ?_⟩
  intro b hb
  have h0 : (b - (w 0 * (2 * y) + w 1 * (3 * x ^ 2 - 1))) • ω = 0 := by
    have e : (b - (w 0 * (2 * y) + w 1 * (3 * x ^ 2 - 1))) • ω =
        b • ω - (w 0 * (2 * y) + w 1 * (3 * x ^ 2 - 1)) • ω := by module
    rw [e, ← hb, ← hc, sub_self]
  have h1 := congrArg φ h0
  rw [map_smul, hφω, smul_eq_mul, mul_one, map_zero] at h1
  exact sub_eq_zero.mp h1

-- The cusp y^2 = x^3: J = (-3x^2, 2y). At (1, 1) the row is (-3, 2), rank 1, fibre 2 - 1 = 1;
-- at (0, 0) it is (0, 0), rank 0, fibre 2.
example : (-3 * 1 ^ 2 : ℤ) = -3 ∧ (2 * 1 : ℤ) = 2 ∧ (-3 * 0 ^ 2 : ℤ) = 0 ∧ (2 * 0 : ℤ) = 0 := by
  norm_num

-- The cubic y^2 = x^3 - x: y = 0 forces x^3 - x = 0, so x = -1, 0, 1, where 3x^2 - 1 is 2, -1, 2,
-- never 0: no singular point.
example : ∀ a ∈ ({-1, 0, 1} : Finset ℤ), a ^ 3 - a = 0 ∧ 3 * a ^ 2 - 1 ≠ 0 := by decide

-- The certificate: ((3/2)x^2 - 1)(3x^2 - 1) - (9/2)x(x^3 - x) = 1.
example (x : ℚ) : (3 / 2 * x ^ 2 - 1) * (3 * x ^ 2 - 1) - 9 / 2 * x * (x ^ 3 - x) = 1 := by ring

-- Over F_7: the cusp's fibre at the origin is 2, so the dual-number count is 7^2 = 49; the cubic
-- has 7 points over F_7, each with count 7^1 = 7.
example : (7 : ℕ) ^ 2 = 49 ∧
    ((Finset.univ : Finset (ZMod 7 × ZMod 7)).filter
      (fun p => p.2 ^ 2 = p.1 ^ 3 - p.1)).card = 7 := by decide

-- House example: a plane curve of degree d = 3 has genus (d - 1)(d - 2)/2 = 1 and Ω = O(d - 3) = O(0).
example : (3 - 1) * (3 - 2) / 2 = 1 ∧ (3 : ℤ) - 3 = 0 := by decide

