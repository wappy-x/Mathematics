-- Ideals and varieties: a system of polynomial equations and the ideal it generates have exactly the same common zeros.
import Mathlib.RingTheory.Nullstellensatz
import Mathlib.RingTheory.Ideal.Span
import Mathlib.Data.ZMod.Basic
import Mathlib.Tactic.NormNum

open MvPolynomial

/-- A system and its ideal have the same points: for polynomials f₁, …, fₛ in n unknowns with
coefficients in a field k, a point with coordinates in a field K containing k is a common zero of
every member of the ideal ⟨f₁, …, fₛ⟩ exactly when it is a common zero of f₁, …, fₛ themselves,
that is V(⟨f₁, …, fₛ⟩) = V(f₁, …, fₛ). -/
theorem variety_of_ideal_eq_variety_of_system {k K : Type*} [Field k] [Field K] [Algebra k K]
    {n s : ℕ} (f : Fin s → MvPolynomial (Fin n) k) :
    zeroLocus K (Ideal.span (Set.range f)) = {p : Fin n → K | ∀ i, aeval p (f i) = 0} := by
  rw [zeroLocus_span]
  ext p
  simp only [Set.forall_mem_range]

/-- The ideal generated by a system is every sum h₁f₁ + ⋯ + hₛfₛ, with h₁, …, hₛ any
polynomials in k[x₁, …, xₙ]. -/
theorem mem_ideal_span_iff_sum_mul {k : Type*} [Field k] {n s : ℕ}
    (f : Fin s → MvPolynomial (Fin n) k) (g : MvPolynomial (Fin n) k) :
    g ∈ Ideal.span (Set.range f) ↔ ∃ h : Fin s → MvPolynomial (Fin n) k, g = ∑ i, h i * f i := by
  rw [Ideal.mem_span_range_iff_exists_fun]
  exact ⟨fun ⟨c, hc⟩ => ⟨c, hc.symm⟩, fun ⟨c, hc⟩ => ⟨c, hc.symm⟩⟩

/-- The ship's two range circles, f₁ = x² + y² − 36 (6 km from beacon A) and
f₂ = x² − 20x + y² + 36 (8 km from beacon B, 10 km east), generate the same ideal over ℚ as the
simpler pair g₁ = 5x − 18 and g₂ = 25y² − 576. Here x is X 0 and y is X 1. -/
theorem beacon_ideal_eq :
    Ideal.span ({X 0 ^ 2 + X 1 ^ 2 - 36, X 0 ^ 2 - 20 * X 0 + X 1 ^ 2 + 36} :
        Set (MvPolynomial (Fin 2) ℚ)) =
      Ideal.span {5 * X 0 - 18, 25 * X 1 ^ 2 - 576} := by
  have ht : (C (1 / 25 : ℚ) : MvPolynomial (Fin 2) ℚ) * 25 = 1 := by
    rw [show (25 : MvPolynomial (Fin 2) ℚ) = C 25 from (map_ofNat C 25).symm, ← map_mul]
    norm_num
  have hu : (C (1 / 4 : ℚ) : MvPolynomial (Fin 2) ℚ) * 4 = 1 := by
    rw [show (4 : MvPolynomial (Fin 2) ℚ) = C 4 from (map_ofNat C 4).symm, ← map_mul]
    norm_num
  apply le_antisymm
  · rw [Ideal.span_le]
    intro q hq
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hq
    rw [SetLike.mem_coe, Ideal.mem_span_pair]
    rcases hq with rfl | rfl
    · refine ⟨C (1 / 25) * (5 * X 0 + 18), C (1 / 25), ?_⟩
      linear_combination (X 0 ^ 2 + X 1 ^ 2 - 36 : MvPolynomial (Fin 2) ℚ) * ht
    · refine ⟨C (1 / 25) * (5 * X 0 + 18) - 4, C (1 / 25), ?_⟩
      linear_combination (X 0 ^ 2 + X 1 ^ 2 - 36 : MvPolynomial (Fin 2) ℚ) * ht
  · rw [Ideal.span_le]
    intro q hq
    simp only [Set.mem_insert_iff, Set.mem_singleton_iff] at hq
    rw [SetLike.mem_coe, Ideal.mem_span_pair]
    rcases hq with rfl | rfl
    · refine ⟨C (1 / 4), -C (1 / 4), ?_⟩
      linear_combination (5 * X 0 - 18 : MvPolynomial (Fin 2) ℚ) * hu
    · refine ⟨25 - C (1 / 4) * (5 * X 0 + 18), C (1 / 4) * (5 * X 0 + 18), ?_⟩
      linear_combination (-(25 * X 0 ^ 2 - 324) : MvPolynomial (Fin 2) ℚ) * hu

-- The second range circle multiplied out: (x − 10)² + y² − 64 = x² − 20x + y² + 36.
example (x y : ℚ) : (x - 10) ^ 2 + y ^ 2 - 64 = x ^ 2 - 20 * x + y ^ 2 + 36 := by ring

-- By the triangle: x = (10² + 6² − 8²)/(2 × 10) = 18/5, and y² = 6² − x² = 576/25.
example : ((10 : ℚ) ^ 2 + 6 ^ 2 - 8 ^ 2) / (2 * 10) = 18 / 5 := by norm_num
example : (6 : ℚ) ^ 2 - (18 / 5) ^ 2 = 576 / 25 := by norm_num

-- Both fixes (18/5, ±24/5) lie on both circles and on g₁ = 0 and g₂ = 0.
example : (18 / 5 : ℚ) ^ 2 + (24 / 5) ^ 2 - 36 = 0 := by norm_num
example : (18 / 5 : ℚ) ^ 2 - 20 * (18 / 5) + (-24 / 5) ^ 2 + 36 = 0 := by norm_num
example : (5 : ℚ) * (18 / 5) - 18 = 0 := by norm_num
example : (25 : ℚ) * (24 / 5) ^ 2 - 576 = 0 := by norm_num

-- A polynomial multiplier: x f₁ − x f₂ = 20x² − 72x reads 1296/5 − 1296/5 = 0 at x = 18/5.
example : (20 : ℚ) * (18 / 5) ^ 2 = 1296 / 5 ∧ (72 : ℚ) * (18 / 5) = 1296 / 5 := by norm_num

-- The bearing 4x − 3y = 0 keeps the north fix (18/5, 24/5) and not the south one.
example : (4 : ℚ) * (18 / 5) - 3 * (24 / 5) = 0 ∧ (4 : ℚ) * (18 / 5) - 3 * (-24 / 5) ≠ 0 := by
  norm_num

-- Tangent ranges (B reads 4 km): x = 6 and y² = 36 − 36 = 0.
example : ((10 : ℚ) ^ 2 + 6 ^ 2 - 4 ^ 2) / (2 * 10) = 6 ∧ (6 : ℚ) ^ 2 - 6 ^ 2 = 0 := by norm_num

-- On the 101-clock: 10² = 100 = −1 and 91² = −1, so x² + 1 has the points 10 and 91.
example : (10 : ZMod 101) ^ 2 + 1 = 0 ∧ (91 : ZMod 101) ^ 2 + 1 = 0 := by decide

-- The fixes reduced mod 101 are (44, 25) and (44, 76): they lie on f₁, f₂, g₁ and g₂.
example : (44 : ZMod 101) ^ 2 + 25 ^ 2 - 36 = 0 ∧ (44 : ZMod 101) ^ 2 + 76 ^ 2 - 36 = 0 := by decide
example : (44 : ZMod 101) ^ 2 - 20 * 44 + 25 ^ 2 + 36 = 0 ∧
    (44 : ZMod 101) ^ 2 - 20 * 44 + 76 ^ 2 + 36 = 0 := by decide
example : (5 : ZMod 101) * 44 - 18 = 0 ∧ (25 : ZMod 101) * 25 ^ 2 - 576 = 0 ∧
    (25 : ZMod 101) * 76 ^ 2 - 576 = 0 := by decide

#print axioms variety_of_ideal_eq_variety_of_system
#print axioms mem_ideal_span_iff_sum_mul
#print axioms beacon_ideal_eq
