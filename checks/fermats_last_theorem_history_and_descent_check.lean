-- Fermat's last theorem: two fourth powers of positive whole numbers never add up to a square, so no exponent that 4 divides has a solution, and in the field of pth roots of 1 an ideal whose pth power is principal is itself principal when p does not divide the class number.
import Mathlib.NumberTheory.FLT.Four
import Mathlib.NumberTheory.NumberField.ClassNumber
import Mathlib.NumberTheory.Cyclotomic.Basic
import Mathlib.Algebra.Group.Nat.Even
import Mathlib.Tactic.NormNum

open NumberField

/-! Whole numbers are `ℕ`. A solution is three positive whole numbers. The field of pth roots
of 1 is `CyclotomicField p ℚ`, its cyclotomic integers are `𝓞 (CyclotomicField p ℚ)`, and its
class number `h_p` is `NumberField.classNumber (CyclotomicField p ℚ)`. Kummer's full theorem on
regular primes is only stated on the card, with a source, so it is not stated here. -/

/-- Fermat's descent for exponent 4. There are no positive whole numbers x, y and z with
x⁴ + y⁴ = z²: two fourth powers never add up to a square. -/
theorem no_fourth_powers_sum_to_square (x y z : ℕ) (hx : 0 < x) (hy : 0 < y) (hz : 0 < z) :
    x ^ 4 + y ^ 4 ≠ z ^ 2 := by
  have _ := hz
  intro h
  have h' : (x : ℤ) ^ 4 + (y : ℤ) ^ 4 = (z : ℤ) ^ 2 := by exact_mod_cast h
  exact not_fermat_42 (by exact_mod_cast hx.ne') (by exact_mod_cast hy.ne') h'

/-- Every exponent that 4 divides is covered. If 4 divides n, then x^n + y^n = z^n has no
solution in positive whole numbers x, y, z; with n = 4 this is x⁴ + y⁴ ≠ z⁴. -/
theorem no_solution_when_four_divides_exponent (n x y z : ℕ) (hn : 4 ∣ n)
    (hx : 0 < x) (hy : 0 < y) (hz : 0 < z) :
    x ^ n + y ^ n ≠ z ^ n := by
  exact fermatLastTheoremFour.mono hn x y z hx.ne' hy.ne' hz.ne'

/-- Kummer's ideal step (Step 8). Let p be an odd prime that does not divide the class number
h_p of the field of pth roots of 1. If a nonzero ideal 𝔞 of the cyclotomic integers has a
principal pth power 𝔞^p, then 𝔞 itself is principal: generated by one number. -/
theorem ideal_principal_of_pow_principal_of_not_dvd_classNumber (p : ℕ) (hp : p.Prime)
    (hodd : Odd p) (hreg : ¬ p ∣ classNumber (CyclotomicField p ℚ))
    (I : Ideal (𝓞 (CyclotomicField p ℚ))) (hI : I ≠ ⊥) (hpow : (I ^ p).IsPrincipal) :
    I.IsPrincipal := by
  have _ := hodd
  have _ := hI
  exact Ideal.IsPrincipal.of_isPrincipal_pow_of_coprime
    ((hp.coprime_iff_not_dvd).mpr hreg) hpow

-- The search size: all pairs 1 ≤ x ≤ y ≤ 1,000 number 500,500.
example : 1000 * 1001 / 2 = 500500 := by norm_num

-- The case table: each exponent from 3 to 12 is a multiple of 4 or of an odd prime.
example : 3 ∣ 3 ∧ 4 ∣ 4 ∧ 5 ∣ 5 ∧ 3 ∣ 6 ∧ 7 ∣ 7 ∧ 4 ∣ 8 ∧ 3 ∣ 9 ∧ 5 ∣ 10 ∧ 11 ∣ 11 ∧ 4 ∣ 12 := by
  decide

-- The descent run backwards from u, v = 2, 1: seeds a, b = 4, 1, then x = 15, s = 8, r = 17.
example : (2 : ℕ) ^ 2 = 4 ∧ (1 : ℕ) ^ 2 = 1 := by norm_num
example : 4 ^ 2 - 1 ^ 2 = 15 ∧ 2 * 4 * 1 = 8 ∧ 4 ^ 2 + 1 ^ 2 = 17 := by norm_num
example : 2 * 17 * 8 = 272 ∧ 17 ^ 2 + 8 ^ 2 = 353 := by norm_num

-- The near miss: 15⁴ + 272² = 50,625 + 73,984 = 124,609 = 353².
example : 15 ^ 4 = 50625 ∧ 272 ^ 2 = 73984 ∧ 50625 + 73984 = 124609 ∧ 353 ^ 2 = 124609 := by
  norm_num
example : 15 ^ 4 + 272 ^ 2 = 353 ^ 2 := by norm_num

-- 272 = 4 × 4 × 1 × 17 is not a square, because 17 = 2⁴ + 1⁴ is not.
example : 272 = 4 * 4 * 1 * 17 ∧ ¬ IsSquare (272 : ℕ) := by decide +kernel
example : 2 ^ 4 + 1 ^ 4 = 17 ∧ ¬ IsSquare (17 : ℕ) := by decide +kernel

-- The size drop: the would-be w⁴ = 17² = 289 is below z = 353.
example : 17 ^ 2 = 289 ∧ 289 < 353 := by norm_num

-- The descent ladder: the largest fourth root below each bound.
-- 10³⁸ gives 3,162,277,660, then 237, then 3, then 1.
example : 3162277660 ^ 4 ≤ 10 ^ 38 - 1 ∧ 10 ^ 38 - 1 < 3162277661 ^ 4 := by norm_num
example : 237 ^ 4 ≤ 3162277660 - 1 ∧ 3162277660 - 1 < 238 ^ 4 := by norm_num
example : 3 ^ 4 ≤ 237 - 1 ∧ 237 - 1 < 4 ^ 4 := by norm_num
example : 1 ^ 4 ≤ 3 - 1 ∧ 3 - 1 < 2 ^ 4 := by norm_num

-- Zero breaks the hypothesis: 0⁴ + 1⁴ = 1².
example : 0 ^ 4 + 1 ^ 4 = 1 ^ 2 := by norm_num

-- Squares do have solutions: 3² + 4² = 5².
example : 3 ^ 2 + 4 ^ 2 = 5 ^ 2 := by norm_num

-- Splitting a square product needs coprimality: 2 × 8 = 16 is a square, gcd(2, 8) = 2,
-- and 2 is not a square.
example : 2 * 8 = 16 ∧ IsSquare (16 : ℕ) ∧ Nat.gcd 2 8 = 2 ∧ ¬ IsSquare (2 : ℕ) := by decide +kernel

-- Kummer's factoring for p = 3: 9³ + 10³ = 1,729 = 12³ + 1 = (9 + 10)(81 − 90 + 100) = 19 × 91.
example : 9 ^ 3 + 10 ^ 3 = 1729 ∧ 12 ^ 3 + 1 = 1729 ∧ 19 * 91 = 1729 := by norm_num
example : (9 + 10 : ℤ) * (81 - 90 + 100) = 9 ^ 3 + 10 ^ 3 := by norm_num

-- Euler's pattern fails (1988): three fourth powers that sum to a fourth power.
example : 2682440 ^ 4 + 15365639 ^ 4 + 18796760 ^ 4 = 20615673 ^ 4 := by norm_num

-- Of the 24 odd primes below 100, the card lists 37, 59 and 67 as irregular.
example : ((Finset.range 100).filter (fun p => p.Prime ∧ p ≠ 2)).card = 24 := by decide

#print axioms no_fourth_powers_sum_to_square
#print axioms no_solution_when_four_divides_exponent
#print axioms ideal_principal_of_pow_principal_of_not_dvd_classNumber
