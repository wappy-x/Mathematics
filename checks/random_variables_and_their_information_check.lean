-- Random variables as measurable maps: a real quantity is measurable for the sigma-algebra another real quantity generates exactly when it is a Borel function of it, that sigma-algebra is the smallest one making the variable measurable, and on a finite range its sets are exactly those that never split a level set.
import Mathlib.MeasureTheory.Function.FactorsThrough
import Mathlib.MeasureTheory.Constructions.BorelSpace.Real

open MeasureTheory

/-- The Doob–Dynkin lemma. Let `X` and `Y` be real-valued functions on any set of outcomes
`Ω` (no probability is used). Then `Y` is measurable for the sigma-algebra generated by `X`,
`σ(X) = {X⁻¹(B) : B Borel}`, exactly when `Y = g(X)` for some Borel function `g : ℝ → ℝ`. -/
theorem doob_dynkin_measurable_iff_borel_function {Ω : Type*} (X Y : Ω → ℝ) :
    Measurable[MeasurableSpace.comap X inferInstance] Y ↔
      ∃ g : ℝ → ℝ, Measurable g ∧ Y = g ∘ X := by
  constructor
  · intro h
    exact h.exists_eq_measurable_comp
  · rintro ⟨g, hg, rfl⟩
    exact hg.comp (comap_measurable X)

/-- What `X` lets you know is the smallest sigma-algebra that makes `X` measurable:
for any sigma-algebra `𝒢` on the outcomes, `X` is `𝒢`-measurable exactly when
`σ(X)` sits inside `𝒢`. -/
theorem measurable_iff_generated_sigma_le {Ω : Type*} (X : Ω → ℝ) (𝒢 : MeasurableSpace Ω) :
    Measurable[𝒢] X ↔ MeasurableSpace.comap X inferInstance ≤ 𝒢 := by
  exact measurable_iff_comap_le

/-- On a finite range, a set of outcomes is in `σ(X)` exactly when it never splits an atom:
whenever two outcomes give `X` the same value, both are in the set or both are out. -/
theorem mem_generated_sigma_iff_never_splits_atom {Ω : Type*} (X : Ω → ℝ)
    (hX : (Set.range X).Finite) (A : Set Ω) :
    MeasurableSet[MeasurableSpace.comap X inferInstance] A ↔
      ∀ ω ω' : Ω, X ω = X ω' → (ω ∈ A ↔ ω' ∈ A) := by
  constructor
  · rintro ⟨B, -, rfl⟩ ω ω' h
    simp only [Set.mem_preimage, h]
  · intro h
    refine ⟨X '' A, (hX.subset (Set.image_subset_range X A)).measurableSet, ?_⟩
    ext ω
    constructor
    · rintro ⟨ω', hω', hx⟩
      exact (h ω' ω hx).1 hω'
    · intro hω
      exact ⟨ω, hω, rfl⟩

/-! Worked numbers from the card: the toy league, scores `(home, away)` with 0 to 3 goals each. -/

/-- The 16 final scores. -/
example : Fintype.card (Fin 4 × Fin 4) = 16 := by decide

/-- Atoms of the total: 1, 2, 3, 4, 3, 2, 1 scores on totals 0 to 6. -/
example : (List.range 7).map (fun t =>
    (Finset.univ.filter (fun s : Fin 4 × Fin 4 => s.1.val + s.2.val = t)).card)
      = [1, 2, 3, 4, 3, 2, 1] := by decide

/-- The total-2 atom is the three scores 0-2, 1-1, 2-0. -/
example : Finset.univ.filter (fun s : Fin 4 × Fin 4 => s.1.val + s.2.val = 2)
    = {(0, 2), (1, 1), (2, 0)} := by decide

/-- σ(T) keeps or drops each of the 7 atoms: 2^7 = 128 of the 2^16 = 65,536 sets of scores. -/
example : 2 ^ 7 = 128 ∧ 2 ^ 16 = 65536 := by norm_num

/-- "More than 3 goals" is 6 scores. -/
example : (Finset.univ.filter (fun s : Fin 4 × Fin 4 => 3 < s.1.val + s.2.val)).card = 6 := by
  decide

/-- "Home won" is 6 scores, and it splits the total-1 atom: 1-0 is a home win, 0-1 is not. -/
example : (Finset.univ.filter (fun s : Fin 4 × Fin 4 => s.2 < s.1)).card = 6 ∧
    ((1 : Fin 4).val + (0 : Fin 4).val = (0 : Fin 4).val + (1 : Fin 4).val) ∧
    (0 : Fin 4) < 1 ∧ ¬ ((1 : Fin 4) < 0) := by decide

/-- "The margin is even" exactly when the total is even, on all 16 scores. -/
example : ∀ s : Fin 4 × Fin 4,
    ((s.1.val : ℤ) - s.2.val) % 2 = 0 ↔ ((s.1.val : ℤ) + s.2.val) % 2 = 0 := by decide

/-- The chance of "more than 3 goals", in ten-thousandths: 1375 + 550 + 150 = 2075,
summed score by score from the home chances 25, 35, 25, 15 and away chances 35, 35, 20, 10
(in hundredths). -/
example : (Finset.univ.filter (fun s : Fin 4 × Fin 4 => 3 < s.1.val + s.2.val)).sum
    (fun s => [25, 35, 25, 15][s.1.val]! * [35, 35, 20, 10][s.2.val]!) = 2075 ∧
    1375 + 550 + 150 = 2075 := by decide

/-- Home win given total 1, by hand: 1-0 over 1-0 or 0-1 is 1225 / 2100. -/
example : 35 * 35 = 1225 ∧ 25 * 35 + 35 * 35 = 2100 := by norm_num

#print axioms doob_dynkin_measurable_iff_borel_function
#print axioms measurable_iff_generated_sigma_le
#print axioms mem_generated_sigma_iff_never_splits_atom
