-- Caratheodory's extension theorem: a premeasure on an algebra of sets extends to a measure on the generated sigma-algebra, given there by the cheapest-cover outer measure, the extension is unique when the premeasure is sigma-finite, and for durations of shifts [a, b) the extension is Lebesgue measure.
import Mathlib.MeasureTheory.Measure.Lebesgue.Basic
import Mathlib.MeasureTheory.Constructions.BorelSpace.Order
import Mathlib.Tactic.NormNum
import Mathlib.MeasureTheory.OuterMeasure.OfAddContent

open MeasureTheory Set Function
open scoped ENNReal

/-- Caratheodory's extension theorem, existence. Let `A` be an algebra of sets on `α`: it contains
the whole space and is closed under complements and finite unions. Let `μ₀` be a premeasure on `A`:
it gives the empty set 0 and adds over countably many disjoint members of `A` whenever their union
is in `A`. Then there is a measure `μ` on the sigma-algebra generated by `A` that agrees with `μ₀`
on every set of `A`, and on every set of that sigma-algebra `μ` equals the outer measure: the
smallest total `∑ μ₀ (f i)` over countable covers by sets `f i` of `A`. -/
theorem premeasure_on_algebra_extends_to_measure {α : Type*} (A : Set (Set α))
    (h_univ : univ ∈ A) (h_compl : ∀ s ∈ A, sᶜ ∈ A) (h_union : ∀ s ∈ A, ∀ t ∈ A, s ∪ t ∈ A)
    (μ₀ : Set α → ℝ≥0∞) (h_empty : μ₀ ∅ = 0)
    (h_add : ∀ f : ℕ → Set α, (∀ i, f i ∈ A) → Pairwise (Disjoint on f) →
      (⋃ i, f i) ∈ A → μ₀ (⋃ i, f i) = ∑' i, μ₀ (f i)) :
    ∃ μ : @Measure α (MeasurableSpace.generateFrom A),
      (∀ s ∈ A, μ s = μ₀ s) ∧
      ∀ s, MeasurableSet[MeasurableSpace.generateFrom A] s →
        μ s = ⨅ (f : ℕ → Set α) (_ : ∀ i, f i ∈ A) (_ : s ⊆ ⋃ i, f i), ∑' i, μ₀ (f i) := by
  classical
  have hRing : IsSetRing A :=
    { empty_mem := by simpa using h_compl _ h_univ
      union_mem := fun s t hs ht => h_union s hs t ht
      sdiff_mem := fun s t hs ht => by
        have h := h_compl _ (h_union _ (h_compl _ hs) _ ht)
        rwa [compl_union, compl_compl, ← sdiff_eq] at h }
  have hSemi : IsSetSemiring A := hRing.isSetSemiring
  let m : AddContent ℝ≥0∞ A := hRing.addContent_of_union μ₀ h_empty (by
    intro s t hs ht hd
    let f : ℕ → Set α := fun n => if n = 0 then s else if n = 1 then t else ∅
    have hU : (⋃ i, f i) = s ∪ t := by
      ext x
      simp only [mem_iUnion, mem_union, f]
      constructor
      · rintro ⟨i, hi⟩
        by_cases h0 : i = 0
        · simp [h0] at hi; exact Or.inl hi
        · by_cases h1 : i = 1
          · simp [h1] at hi; exact Or.inr hi
          · simp [h0, h1] at hi
      · rintro (h | h)
        · exact ⟨0, by simpa using h⟩
        · exact ⟨1, by simpa using h⟩
    have hfA : ∀ i, f i ∈ A := by
      intro i
      simp only [f]
      split_ifs
      · exact hs
      · exact ht
      · exact hRing.empty_mem
    have hfd : Pairwise (Disjoint on f) := by
      intro i j hij
      simp only [Function.onFun, f]
      split_ifs <;> first | (exfalso; omega) | exact hd | exact hd.symm | simp
    have key := h_add f hfA hfd (hU ▸ hRing.union_mem hs ht)
    rw [hU] at key
    rw [key, tsum_eq_sum (s := Finset.range 2)]
    · simp [Finset.sum_range_succ, f]
    · intro i hi
      simp only [Finset.mem_range, not_lt] at hi
      have h0 : i ≠ 0 := by omega
      have h1 : i ≠ 1 := by omega
      simp [f, h0, h1, h_empty])
  have hsub : m.IsSigmaSubadditive :=
    isSigmaSubadditive_of_addContent_iUnion_eq_tsum hRing (fun f hf hU hd => h_add f hf hd hU)
  refine ⟨@AddContent.measure α A (MeasurableSpace.generateFrom A) m hSemi le_rfl hsub, ?_, ?_⟩
  · intro s hs
    exact @AddContent.measure_eq α A s (MeasurableSpace.generateFrom A) m hSemi rfl hsub hs
  · intro s hs
    refine (trim_measurableSet_eq (μ := m.measureCaratheodory hSemi hsub)
      (fun t ht => AddContent.isCaratheodory_inducedOuterMeasure hSemi m t ht) hs).trans ?_
    rw [AddContent.measureCaratheodory_eq_inducedOuterMeasure]
    show OuterMeasure.ofFunction _ _ s = _
    rw [OuterMeasure.ofFunction_eq_iInf_mem (P := (· ∈ A))]
    · refine iInf_congr fun f => iInf_congr fun hf => iInf_congr fun _ => ?_
      exact tsum_congr fun i => extend_eq _ (hf i)
    · intro t ht
      exact extend_eq_top _ ht

/-- Caratheodory's extension theorem, uniqueness. With `A` and `μ₀` as above, suppose `μ₀` is
sigma-finite: the whole space is a countable union of sets `Ω n` of `A` with `μ₀ (Ω n) < ∞`.
Then any two measures on the generated sigma-algebra that agree with `μ₀` on `A` are equal. -/
theorem sigma_finite_premeasure_extension_unique {α : Type*} (A : Set (Set α))
    (h_univ : univ ∈ A) (h_compl : ∀ s ∈ A, sᶜ ∈ A) (h_union : ∀ s ∈ A, ∀ t ∈ A, s ∪ t ∈ A)
    (μ₀ : Set α → ℝ≥0∞) (h_empty : μ₀ ∅ = 0)
    (h_add : ∀ f : ℕ → Set α, (∀ i, f i ∈ A) → Pairwise (Disjoint on f) →
      (⋃ i, f i) ∈ A → μ₀ (⋃ i, f i) = ∑' i, μ₀ (f i))
    (Ω : ℕ → Set α) (hΩ_mem : ∀ n, Ω n ∈ A) (hΩ_fin : ∀ n, μ₀ (Ω n) < ∞)
    (hΩ_cover : (⋃ n, Ω n) = univ)
    (μ ν : @Measure α (MeasurableSpace.generateFrom A))
    (hμ : ∀ s ∈ A, μ s = μ₀ s) (hν : ∀ s ∈ A, ν s = μ₀ s) :
    μ = ν := by
  let _ : MeasurableSpace α := MeasurableSpace.generateFrom A
  have hPi : IsPiSystem A := by
    intro s hs t ht _
    have h := h_compl _ (h_union _ (h_compl _ hs) _ (h_compl _ ht))
    rwa [compl_union, compl_compl, compl_compl] at h
  refine Measure.ext_of_generateFrom_of_iUnion A Ω rfl hPi hΩ_cover hΩ_mem ?_ ?_
  · intro i
    rw [hμ _ (hΩ_mem i)]
    exact (hΩ_fin i).ne
  · intro s hs
    rw [hμ s hs, hν s hs]

/-- Step 6 of the card: duration on shifts extends to exactly one measure on the Borel sets of the
real line, Lebesgue measure. Lebesgue measure gives every shift `[a, b)` its duration `b - a`, and
any measure on the Borel sets that gives every shift `[a, b)` with `a ≤ b` its duration is
Lebesgue measure. -/
theorem duration_on_shifts_extends_uniquely_to_lebesgue :
    (∀ a b : ℝ, volume (Ico a b) = ENNReal.ofReal (b - a)) ∧
    ∀ μ : Measure ℝ, (∀ a b : ℝ, a ≤ b → μ (Ico a b) = ENNReal.ofReal (b - a)) → μ = volume := by
  refine ⟨fun a b => Real.volume_Ico, fun μ hμ => ?_⟩
  refine Measure.ext_of_Ico' μ volume (fun a b hab => ?_) (fun a b hab => ?_)
  · rw [hμ a b hab.le]
    exact ENNReal.ofReal_ne_top
  · rw [hμ a b hab.le, Real.volume_Ico]

-- Worked numbers, by hand. The early shift lasts 14 - 6 = 8 hours.
example : (14 : ℕ) - 6 = 8 := by decide
-- Early and night together: 8 + 8 = 16 hours.
example : ((14 : ℕ) - 6) + (30 - 22) = 16 := by decide
-- Early cut into halves of what is left, after 6 pieces: 4 + 2 + 1 + 1/2 + 1/4 + 1/8 = 63/8.
example : (4 : ℚ) + 2 + 1 + 1/2 + 1/4 + 1/8 = 63/8 := by norm_num
-- The same sum is 8 - 8/2^6.
example : (8 : ℚ) - 8 / 2^6 = 63/8 := by norm_num
-- Left over after 30 pieces: 8 / 2^30 = 1/134217728 hours.
example : (8 : ℚ) / 2^30 = 1/134217728 := by norm_num
-- Pager bursts: (1/4) / (1 - 1/2) = 1/2 hour, which is 60 × 1/2 = 30 minutes.
example : ((1 : ℚ)/4) / (1 - 1/2) = 1/2 := by norm_num
example : (60 : ℚ) * (1/2) = 30 := by norm_num
-- The squeeze after 40 bursts leaves a gap of 1/2^40 = 1/1099511627776 hour.
example : (1 : ℚ) / 2^40 = 1/1099511627776 := by norm_num
-- Closed stretch [6, 14] inside [6, 14 + 1/n): sizes 9, 81/10, 8001/1000 for n = 1, 10, 1000.
example : (14 : ℚ) + 1/1 - 6 = 9 ∧ (14 : ℚ) + 1/10 - 6 = 81/10 ∧ (14 : ℚ) + 1/1000 - 6 = 8001/1000 := by
  norm_num
-- The small algebra cut at 6, 14 and 22: 2^4 = 16 sets, tested on 16 + 5 sets, 336 checks.
example : (2 : ℕ)^4 = 16 ∧ 16 * (16 + 5) = 336 := by decide

#print axioms premeasure_on_algebra_extends_to_measure
#print axioms sigma_finite_premeasure_extension_unique
#print axioms duration_on_shifts_extends_uniquely_to_lebesgue
