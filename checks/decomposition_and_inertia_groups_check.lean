-- Decomposition and inertia groups: in a Galois number field the symmetries reach every prime ideal above p, the decomposition group of one has e times f members and its inertia group e, so efg equals the degree, and the decomposition group maps onto the residue field's symmetries with kernel the inertia group, Frobenius being one symmetry exactly when e = 1.
import Mathlib.NumberTheory.RamificationInertia.Galois
import Mathlib.NumberTheory.NumberField.Basic
import Mathlib.FieldTheory.Galois.IsGaloisGroup
import Mathlib.RingTheory.Frobenius
import Mathlib.GroupTheory.Perm.Cycle.Type
import Mathlib.Data.ZMod.Basic
import Mathlib.Tactic.NormNum

open NumberField
open scoped Pointwise

/-- The main theorem of the card. Let `K` be a Galois number field of degree `n` over `ℚ`,
`p` a prime and `𝔓` a prime ideal of its full ring of integers `O_K` above `p`, with
ramification index `e` and residue degree `f`. Then the symmetries carry `𝔓` to every prime
ideal above `p`; the decomposition group `D` (symmetries with `σ(𝔓) = 𝔓`) has `e·f` members;
the inertia group `I` (symmetries with `σ(x) ≡ x mod 𝔓` for every `x`) has `e` members; and
the number `g` of prime ideals above `p` satisfies `g·e·f = n`. -/
theorem decomposition_and_inertia_group_sizes (K : Type*) [Field K] [NumberField K]
    [IsGalois ℚ K] (p : ℕ) (hp : p.Prime) (P : Ideal (𝓞 K)) [P.IsPrime]
    [P.LiesOver (Ideal.span {(p : ℤ)})] :
    (∀ Q ∈ (Ideal.span {(p : ℤ)}).primesOver (𝓞 K), ∃ σ : K ≃ₐ[ℚ] K, σ • P = Q) ∧
    Nat.card (MulAction.stabilizer (K ≃ₐ[ℚ] K) P) = P.ramificationIdx ℤ * P.inertiaDeg ℤ ∧
    Nat.card (P.inertia (K ≃ₐ[ℚ] K)) = P.ramificationIdx ℤ ∧
    ((Ideal.span {(p : ℤ)}).primesOver (𝓞 K)).ncard *
      (P.ramificationIdx ℤ * P.inertiaDeg ℤ) = Module.finrank ℚ K := by
  have hmax : (Ideal.span {(p : ℤ)}).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible (Nat.prime_iff_prime_int.mp hp).irreducible
  have : Finite (ℤ ⧸ Ideal.span {(p : ℤ)}) := by
    have : NeZero p := ⟨hp.ne_zero⟩
    exact Finite.of_equiv _ (Int.quotientSpanNatEquivZMod p).symm.toEquiv
  have : (Ideal.span {(p : ℤ)}).IsPrime := hmax.isPrime
  have : PerfectField (Ideal.span {(p : ℤ)}).ResidueField := inferInstance
  have hsep : Algebra.HasSeparableResidueFieldsAt ℤ (𝓞 K) (Ideal.span {(p : ℤ)}) := inferInstance
  have hS := Ideal.card_stabilizer_eq_card_inertia_mul_finrank (G := K ≃ₐ[ℚ] K)
    (Ideal.span {(p : ℤ)}) P
  have hI := Ideal.card_inertia_eq_ramificationIdxIn (G := K ≃ₐ[ℚ] K) (Ideal.span {(p : ℤ)}) P
  rw [Ideal.ramificationIdxIn_eq_ramificationIdx (Ideal.span {(p : ℤ)}) P (K ≃ₐ[ℚ] K)] at hI
  have hF := Ideal.ncard_primesOver_mul_ramificationIdxIn_mul_inertiaDegIn
    (Ideal.span {(p : ℤ)}) (𝓞 K) (K ≃ₐ[ℚ] K)
  rw [Ideal.ramificationIdxIn_eq_ramificationIdx (Ideal.span {(p : ℤ)}) P (K ≃ₐ[ℚ] K),
    Ideal.inertiaDegIn_eq_inertiaDeg (Ideal.span {(p : ℤ)}) P (K ≃ₐ[ℚ] K),
    ] at hF
  refine ⟨fun Q hQ => ?_, by rw [hS, hI], hI,
    hF.trans (IsGalois.card_aut_eq_finrank ℚ K)⟩
  have := hQ.1
  have := hQ.2
  exact Ideal.exists_smul_eq_of_isGaloisGroup (Ideal.span {(p : ℤ)}) P Q (K ≃ₐ[ℚ] K)

/-- Step 3 of the card: `D/I` is the residue field's symmetry group. Each symmetry in the
decomposition group `D` of `𝔓` acts on the residue field `O_K/𝔓` over `GF(p) = ℤ/p`; this map
from `D` onto `Gal((O_K/𝔓)/GF(p))` is onto, and the symmetries sent to the identity are
exactly the inertia group `I`. -/
theorem decomposition_group_onto_residue_galois_with_kernel_inertia (K : Type*) [Field K]
    [NumberField K] [IsGalois ℚ K] (p : ℕ) (hp : p.Prime) (P : Ideal (𝓞 K)) [P.IsPrime]
    [P.LiesOver (Ideal.span {(p : ℤ)})] :
    Function.Surjective
        (Ideal.Quotient.stabilizerHom P (Ideal.span {(p : ℤ)}) (K ≃ₐ[ℚ] K)) ∧
      (Ideal.Quotient.stabilizerHom P (Ideal.span {(p : ℤ)}) (K ≃ₐ[ℚ] K)).ker =
        P.inertia (MulAction.stabilizer (K ≃ₐ[ℚ] K) P) := by
  exact ⟨Ideal.Quotient.stabilizerHom_surjective (K ≃ₐ[ℚ] K) (Ideal.span {(p : ℤ)}) P,
    Ideal.Quotient.ker_stabilizerHom P (Ideal.span {(p : ℤ)}) (K ≃ₐ[ℚ] K)⟩

/-- Frobenius: some symmetry acts on `O_K/𝔓` as the `p`-th power map; every member of the
decomposition group acts as one of `Frob⁰, …, Frob^(f-1)`, so `D/I` is generated by Frobenius;
and exactly one symmetry acts as Frobenius precisely when `e = 1` (at a ramified prime a whole
coset of `I` does). -/
theorem frobenius_generates_and_unique_iff_unramified (K : Type*) [Field K] [NumberField K]
    [IsGalois ℚ K] (p : ℕ) (hp : p.Prime) (P : Ideal (𝓞 K)) [P.IsPrime]
    [P.LiesOver (Ideal.span {(p : ℤ)})] :
    (∃ σ : K ≃ₐ[ℚ] K, ∀ x : 𝓞 K, σ • x - x ^ p ∈ P) ∧
    (∀ σ ∈ MulAction.stabilizer (K ≃ₐ[ℚ] K) P,
      ∃ k < P.inertiaDeg ℤ, ∀ x : 𝓞 K, σ • x - x ^ (p ^ k) ∈ P) ∧
    ((∃! σ : K ≃ₐ[ℚ] K, ∀ x : 𝓞 K, σ • x - x ^ p ∈ P) ↔ P.ramificationIdx ℤ = 1) := by
  have hIcard : Nat.card (P.inertia (K ≃ₐ[ℚ] K)) = P.ramificationIdx ℤ :=
    (decomposition_and_inertia_group_sizes K p hp P).2.2.1
  have hmax : (Ideal.span {(p : ℤ)}).IsMaximal :=
    PrincipalIdealRing.isMaximal_of_irreducible (Nat.prime_iff_prime_int.mp hp).irreducible
  have : NeZero p := ⟨hp.ne_zero⟩
  have hcardZ : Nat.card (ℤ ⧸ Ideal.span {(p : ℤ)}) = p := by
    rw [Nat.card_congr (Int.quotientSpanNatEquivZMod p).toEquiv, Nat.card_zmod]
  have : Finite (ℤ ⧸ Ideal.span {(p : ℤ)}) :=
    Finite.of_equiv _ (Int.quotientSpanNatEquivZMod p).symm.toEquiv
  have hPmax : P.IsMaximal := Ideal.IsMaximal.of_liesOver_isMaximal P (Ideal.span {(p : ℤ)})
  have : Finite (𝓞 K ⧸ P) := inferInstance
  have hunder : P.under ℤ = Ideal.span {(p : ℤ)} := (Ideal.over_def P _).symm
  have hF : ∀ σ : K ≃ₐ[ℚ] K, IsArithFrobAt ℤ σ P ↔ ∀ x : 𝓞 K, σ • x - x ^ p ∈ P := by
    intro σ
    unfold IsArithFrobAt AlgHom.IsArithFrobAt
    rw [hunder, hcardZ]
    rfl
  obtain ⟨σ₀, h₀⟩ := IsArithFrobAt.exists_of_isInvariant ℤ (K ≃ₐ[ℚ] K) P
  have h₀' := (hF σ₀).mp h₀
  refine ⟨⟨σ₀, h₀'⟩, ?_, ?_⟩
  · intro σ hσ
    let := Ideal.Quotient.field (Ideal.span {(p : ℤ)})
    let := Ideal.Quotient.field P
    let := Fintype.ofFinite (ℤ ⧸ Ideal.span {(p : ℤ)})
    obtain ⟨n, hn⟩ := (FiniteField.bijective_frobeniusAlgEquivOfAlgebraic_pow
      (ℤ ⧸ Ideal.span {(p : ℤ)}) (𝓞 K ⧸ P)).2
      (Ideal.Quotient.stabilizerHom P (Ideal.span {(p : ℤ)}) (K ≃ₐ[ℚ] K) ⟨σ, hσ⟩)
    refine ⟨n.1, ?_, fun x => ?_⟩
    · rw [Ideal.inertiaDeg_eq_of_isMaximal (Ideal.span {(p : ℤ)}) P]
      exact n.2
    · rw [← Ideal.Quotient.eq]
      have hx := congrArg (fun f => f (Ideal.Quotient.mk P x)) hn
      simp only [AlgEquiv.coe_pow, FiniteField.coe_frobeniusAlgEquivOfAlgebraic_iterate,
        Ideal.Quotient.stabilizerHom_apply, Fintype.card_eq_nat_card, hcardZ] at hx
      rw [map_pow, hx]
      rfl
  · have hconj : ∀ τ ∈ P.inertia (K ≃ₐ[ℚ] K), ∀ x : 𝓞 K, (τ * σ₀) • x - x ^ p ∈ P := by
      intro τ hτ x
      have h1 := (Ideal.mem_inertia.mp hτ) (σ₀ • x)
      have := P.add_mem h1 (h₀' x)
      rw [mul_smul]
      convert this using 1
      ring
    constructor
    · rintro ⟨σ, -, huniq⟩
      rw [← hIcard, Subgroup.card_eq_one, Subgroup.eq_bot_iff_forall]
      intro τ hτ
      have e1 := huniq (τ * σ₀) (hconj τ hτ)
      have e2 := huniq σ₀ h₀'
      have : τ * σ₀ = 1 * σ₀ := by rw [e1, e2, one_mul]
      exact mul_right_cancel this
    · intro he
      rw [← hIcard, Subgroup.card_eq_one] at he
      refine ⟨σ₀, h₀', fun σ hσ => ?_⟩
      have := IsArithFrobAt.mul_inv_mem_inertia ((hF σ).mpr hσ) h₀
      rw [he, Subgroup.mem_bot, mul_inv_eq_one] at this
      exact this

-- The card's worked numbers.
-- 31 splits completely: 4³ = 64 = 2 + 2 × 31, and 31 is 1 mod 3.
example : (4 : ℤ) ^ 3 = 64 ∧ (64 : ℤ) = 2 + 2 * 31 ∧ 31 % 3 = 1 := by norm_num
-- Mod 31, x³ - 2 has the three roots 4, 7, 20 and x² + x + 1 the two roots 5, 25.
example : (Finset.univ.filter (fun x : ZMod 31 => x ^ 3 - 2 = 0)) = {4, 7, 20} := by decide
example : (Finset.univ.filter (fun x : ZMod 31 => x ^ 2 + x + 1 = 0)) = {5, 25} := by decide
-- At 5: x³ - 2 has the single root 3 (a line times a quadratic); x² + x + 1 has no root.
example : (Finset.univ.filter (fun x : ZMod 5 => x ^ 3 - 2 = 0)) = {3} := by decide
example : ∀ x : ZMod 5, x ^ 2 + x + 1 ≠ 0 := by decide
-- At 7: x³ - 2 has no root (an irreducible cubic); x² + x + 1 has the two roots 2 and 4.
example : ∀ x : ZMod 7, x ^ 3 - 2 ≠ 0 := by decide
example : (Finset.univ.filter (fun x : ZMod 7 => x ^ 2 + x + 1 = 0)) = {2, 4} := by decide
-- At 2: x³ - 2 = x³ (a line cubed) and x² + x + 1 has no root (a quadratic).
example : (∀ x : ZMod 2, x ^ 3 - 2 = x ^ 3) ∧ (∀ x : ZMod 2, x ^ 2 + x + 1 ≠ 0) := by decide
-- At 3: x³ - 2 = (x + 1)³ and x² + x + 1 = (x - 1)².
example : (∀ x : ZMod 3, x ^ 3 - 2 = (x + 1) ^ 3) ∧
    (∀ x : ZMod 3, x ^ 2 + x + 1 = (x - 1) ^ 2) := by decide
-- e·f·g = 6 at 31, 5, 7, 2 and 3: (1,1,6), (1,2,3), (1,3,2), (3,2,1), (6,1,1).
example : 1 * 1 * 6 = 6 ∧ 1 * 2 * 3 = 6 ∧ 1 * 3 * 2 = 6 ∧ 3 * 2 * 1 = 6 ∧ 6 * 1 * 1 = 6 := by
  norm_num
-- Reading off the subgroups at 2: |D| = 6, |I| = 3 give e = 3, f = 6/3 = 2, g = 6/6 = 1.
example : 6 / 3 = 2 ∧ 6 / 6 = 1 := by norm_num
-- S₃ has 6 members: one identity, three swaps, two rotations (A₃ = identity and rotations).
example : Fintype.card (Equiv.Perm (Fin 3)) = 6 ∧
    (Finset.univ.filter (fun σ : Equiv.Perm (Fin 3) => σ.cycleType = {2})).card = 3 ∧
    (Finset.univ.filter (fun σ : Equiv.Perm (Fin 3) => σ.cycleType = {3})).card = 2 := by
  decide
-- At 3, I = S₃ is not cyclic: every member has order dividing 2 or 3, none has order 6.
example : ∀ σ : Equiv.Perm (Fin 3), σ ^ 2 = 1 ∨ σ ^ 3 = 1 := by decide
-- Below 50, the unramified primes with |D| = 2 are those 2 mod 3.
example : (List.range 50).filter (fun p => p.Prime ∧ p > 3 ∧ p % 3 = 2) =
    [5, 11, 17, 23, 29, 41, 47] := by decide
-- House field: below 50, D is trivial exactly at the odd primes 1 or 9 mod 20, namely 29 and 41.
example : (List.range 50).filter (fun p => p.Prime ∧ p > 2 ∧ (p % 20 = 1 ∨ p % 20 = 9)) =
    [29, 41] := by decide
-- 29 and 41 are x² + 5y².
example : (29 : ℤ) = 3 ^ 2 + 5 * 2 ^ 2 ∧ (41 : ℤ) = 6 ^ 2 + 5 * 1 ^ 2 := by norm_num
-- Mod 29, both x² + 5 and x² + 1 have two roots, so 29 splits completely in H.
example : (Finset.univ.filter (fun x : ZMod 29 => x ^ 2 + 5 = 0)) = {13, 16} ∧
    (Finset.univ.filter (fun x : ZMod 29 => x ^ 2 + 1 = 0)) = {12, 17} := by decide

#print axioms decomposition_and_inertia_group_sizes
#print axioms decomposition_group_onto_residue_galois_with_kernel_inertia
#print axioms frobenius_generates_and_unique_iff_unramified
